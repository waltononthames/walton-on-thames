---
// One lightbox per page for listing photographs. Any link marked
// `data-lightbox` whose href is an image opens here instead of navigating;
// its caption comes from `data-caption` and its alt text from the thumbnail
// inside it. Without JavaScript, or where <dialog> is unsupported, the link
// simply opens the image. Closes with the button, Escape or a click on the
// dimmed backdrop.
---

<dialog class="photo-lightbox" aria-label="Enlarged photograph">
  <button type="button" class="photo-lightbox-close" aria-label="Close">×</button>
  <figure>
    <img alt="" />
    <figcaption></figcaption>
  </figure>
</dialog>

<script is:inline>
  (() => {
    const dialog = document.querySelector('.photo-lightbox');
    if (!dialog || typeof dialog.showModal !== 'function') return;
    const img = dialog.querySelector('img');
    const caption = dialog.querySelector('figcaption');
    document.querySelectorAll('a[data-lightbox]').forEach((link) => {
      link.addEventListener('click', (e) => {
        e.preventDefault();
        const thumb = link.querySelector('img');
        img.src = link.getAttribute('href');
        img.alt = thumb ? thumb.alt : '';
        caption.textContent = link.dataset.caption || '';
        caption.hidden = !caption.textContent;
        dialog.showModal();
      });
    });
    dialog.querySelector('.photo-lightbox-close').addEventListener('click', () => dialog.close());
    // A click on the dimmed backdrop lands on the dialog itself.
    dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });
  })();
</script>

<style>
  .photo-lightbox {
    /* The global reset zeroes margins, which is what normally centres a
       modal dialog, so centre it explicitly. */
    margin: auto;
    inset: 0;
    border: none;
    padding: 0;
    background: transparent;
    max-width: min(96vw, 1600px);
    max-height: 94vh;
    overflow: visible;
  }

  .photo-lightbox::backdrop { background: rgba(1, 32, 44, 0.88); }

  .photo-lightbox figure { margin: 0; }

  .photo-lightbox img {
    display: block;
    max-width: 100%;
    max-height: 86vh;
    width: auto;
    height: auto;
    margin: 0 auto;
    border-radius: var(--radius-md);
  }

  .photo-lightbox figcaption {
    color: var(--color-white);
    font-size: 0.9rem;
    text-align: center;
    margin-top: 0.6rem;
  }

  .photo-lightbox-close {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 2px solid var(--color-white);
    background: var(--color-navy);
    color: var(--color-white);
    font-size: 1.6rem;
    line-height: 1;
    cursor: pointer;
    z-index: 1;
  }

  .photo-lightbox-close:focus-visible { outline: 3px solid var(--color-accent); outline-offset: 2px; }
</style>
