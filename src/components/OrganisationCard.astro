---
// Card for one organisation on a clubs hub.
//
// Three link states, in order of preference:
//   hasPage      links to /clubs/<slug>/
//   internalUrl  links to the page the organisation already has elsewhere on
//                the site, so no duplicate is created for it
//   website      links out to the organisation's own site, marked as external
//
// The brief originally kept external links off the hub entirely, so a card
// with no page of its own rendered as dead text. In practice that stranded
// a third of the directory: a reader who found Esher Rugby or Walton Charity
// had nowhere to go next. Darren asked for the rule to be reversed on
// 12 September 2026. Every published record carries a `website`, so in
// practice every card now links somewhere; the plain-text fallback is kept
// for the case where one does not.
import {
  AUDIENCE_LABELS, LOCALITY_LABELS,
  type OrganisationAudience, type OrganisationLocality,
} from '../utils/organisations';

interface Props {
  name: string;
  slug: string;
  shortDescription: string;
  subcategory?: string;
  locality: OrganisationLocality[];
  audience: OrganisationAudience[];
  ageRange?: string;
  venue?: string;
  hasPage: boolean;
  internalUrl?: string;
  website?: string;
}

const {
  name, slug, shortDescription, subcategory,
  locality, audience, ageRange, venue, hasPage, internalUrl, website,
} = Astro.props;

const internalHref = hasPage ? `/clubs/${slug}/` : internalUrl;
const href = internalHref ?? website;
const isExternal = !internalHref && !!website;
---

<article class="card org-card">
  <div class="card-body">
    {subcategory && <span class="card-category">{subcategory}</span>}

    <h4 class="card-title org-card-title">
      {href
        ? (
          <a href={href} target={isExternal ? '_blank' : undefined} rel={isExternal ? 'noopener' : undefined}>
            {name}
            {isExternal && (
              <>
                <svg class="external-icon" viewBox="0 0 16 16" width="12" height="12" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M6.5 3.5h6v6M12.5 3.5 4 12"/></svg>
                <span class="sr-only"> (opens the organisation's own site in a new tab)</span>
              </>
            )}
          </a>
        )
        : name}
    </h4>

    <p class="card-description">{shortDescription}</p>

    {(ageRange || venue) && (
      <dl class="org-card-detail">
        {ageRange && (
          <div>
            <dt>Ages</dt>
            <dd>{ageRange}</dd>
          </div>
        )}
        {venue && (
          <div>
            <dt>Where</dt>
            <dd>{venue}</dd>
          </div>
        )}
      </dl>
    )}

    <p class="org-card-badges">
      {locality.map(l => <span class="badge">{LOCALITY_LABELS[l]}</span>)}
      {audience.map(a => <span class="badge badge-audience">{AUDIENCE_LABELS[a]}</span>)}
    </p>

    {href && (
      <p class="org-card-cta">
        <a
          href={href}
          class="org-card-cta-link"
          target={isExternal ? '_blank' : undefined}
          rel={isExternal ? 'noopener' : undefined}
        >
          {isExternal ? `Visit ${name}` : `View ${name}`}
          {isExternal
            ? (
              <>
                <svg class="external-icon" viewBox="0 0 16 16" width="12" height="12" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M6.5 3.5h6v6M12.5 3.5 4 12"/></svg>
                <span class="sr-only"> (opens in a new tab)</span>
              </>
            )
            : <span aria-hidden="true"> &rsaquo;</span>}
        </a>
      </p>
    )}
  </div>
</article>

<style>
  .org-card {
    /* The whole card is not a link: some cards have no destination at all,
       and a card that is sometimes clickable and sometimes not is worse
       than one that never is. The heading and the CTA carry the link. */
    cursor: auto;
  }

  .org-card-title {
    margin-top: 0.15rem;
  }

  .org-card-title a {
    color: inherit;
    text-decoration: none;
  }

  .org-card-title a:hover,
  .org-card-title a:focus-visible {
    color: var(--color-accent-dark);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  /* Matches AttractionCard's treatment, so an outbound link looks the same
     wherever it appears on the site. */
  .external-icon {
    flex-shrink: 0;
    margin-left: 0.25rem;
    color: var(--color-slate);
    vertical-align: baseline;
  }

  .org-card-detail {
    margin: 0.6rem 0 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    font-size: 0.8rem;
    line-height: 1.45;
  }

  .org-card-detail > div {
    display: flex;
    gap: 0.4rem;
  }

  .org-card-detail dt {
    flex-shrink: 0;
    font-weight: 600;
    color: var(--color-navy);
  }

  .org-card-detail dd {
    color: var(--color-slate);
  }

  .org-card-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: auto;
    padding-top: 0.5rem;
  }

  .badge-audience {
    background: rgba(184, 134, 46, 0.12);
    color: var(--color-accent-dark);
  }

  .org-card-cta {
    margin-top: 0.75rem;
  }

  .org-card-cta-link {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-accent-dark);
    text-decoration: none;
  }

  .org-card-cta-link:hover,
  .org-card-cta-link:focus-visible {
    text-decoration: underline;
    text-underline-offset: 2px;
  }
</style>
