---
// The matchday card (brief 7.8). Hidden on screen; when the page is printed
// (or saved as a PDF from the print dialog) it is the only thing on the page,
// laid out to fit one A4 sheet. Everything on it comes from the same data as
// the page, so the card and the page cannot disagree.
import { clockFromMinutes, plan, serviceMinutes, type FinderData } from '../../utils/trainTimes';

interface Props {
  address: string;
  postcode?: string;
  kickOffs: string[];
  routes: { title: string; streets: string; minutes: number; km: string; pubs: string[] }[];
  finder: FinderData;
  taxi: string[];
  bus?: string;
  safety: string[];
  officialSite: string;
  checked?: string;
}
const { address, postcode, kickOffs, routes, finder, taxi, bus, safety, officialSite, checked } = Astro.props;
const days = [{ key: 'saturday', label: 'Saturday' }, { key: 'weekday', label: 'Midweek' }];
---

<section class="print-card" aria-hidden="true">
  <header>
    <p class="pc-kicker">Walton-on-Thames.org · Matchday card</p>
    <h2>Walton &amp; Hersham FC: Elmbridge Xcel Sports Hub</h2>
    <p class="pc-address">{address}{postcode && <>, <strong>{postcode}</strong></>}</p>
    <p>{kickOffs.join(' · ')}</p>
  </header>
  <div class="pc-grid">
    <div>
      <h3>From Walton-on-Thames station</h3>
      {routes.map((r) => (
        <p><strong>{r.title}</strong>, {r.km} km, about {r.minutes} minutes: {r.streets}.{r.pubs.length > 0 && <> Pubs: {r.pubs.join(', ')}.</>}</p>
      ))}
      {bus && <p><strong>Bus:</strong> {bus}</p>}
      {taxi.map((t) => <p>{t}</p>)}
    </div>
    <div>
      <h3>Trains home, walking back by road</h3>
      {days.map((d) => {
        const { fullTime, rows } = plan(finder, d.key, 'road', 3);
        return rows.length > 0 && (
          <table>
            <caption>{d.label}{fullTime != null && `, full time around ${clockFromMinutes(fullTime)}`}</caption>
            <tbody>
              {rows.map((r) => (
                <tr><td>Leave {clockFromMinutes(r.leaveBy)}</td><td>{clockFromMinutes(serviceMinutes(r.train.time))} to {r.train.direction}{r.last && ' (last)'}</td></tr>
              ))}
            </tbody>
          </table>
        );
      })}
      <h3>If you need help</h3>
      {safety.map((s) => <p>{s}</p>)}
    </div>
  </div>
  <footer>
    <p>Independent guide, not connected to Walton &amp; Hersham FC. Tickets and matchday news: {officialSite.replace(/^https?:\/\//, '').replace(/\/$/, '')}. {checked && `Checked ${checked}.`} Check live train times before you travel.</p>
  </footer>
</section>

<style>
  .print-card { display: none; }
  @media print {
    @page { size: A4; margin: 12mm; }
    :global(.site-header), :global(footer.site-footer), :global(.skip-link) { display: none !important; }
    :global(#main-content > *:not(.print-card)) { display: none !important; }
    :global(body) { background: #FFFFFF !important; padding: 0 !important; }
    .print-card { display: block; color: #000000; font-size: 10.5pt; line-height: 1.35; }
    h2 { font-size: 17pt; margin: 2pt 0 4pt; }
    h3 { font-size: 11.5pt; margin: 8pt 0 3pt; border-bottom: 1pt solid #999999; }
    .pc-kicker { font-size: 9pt; letter-spacing: 0.08em; text-transform: uppercase; }
    .pc-address { font-size: 12pt; }
    .pc-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10mm; }
    p { margin: 0 0 4pt; }
    table { width: 100%; border-collapse: collapse; margin-bottom: 4pt; font-size: 10pt; }
    caption { text-align: left; font-weight: 700; }
    td { padding: 1pt 0; border-bottom: 0.5pt solid #CCCCCC; }
    footer { margin-top: 8pt; padding-top: 4pt; border-top: 1pt solid #999999; font-size: 9pt; }
  }
</style>
