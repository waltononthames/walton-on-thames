---
// One photograph slot in the away guide. Until Darren supplies the photo, it
// renders a neutral block at the right aspect ratio, labelled with the slot
// name from docs/away-fans-guide-shot-list.md, so the layout can be judged.
//
// Slot names follow af-<chapter>-<subject>-<orientation>. Pass the name
// without the orientation: key images get a landscape and a portrait crop,
// and the portrait one is what phones will be served (<picture> with
// <source media>) once real files exist under src/assets/away-guide/.
interface Props {
  slot: string;
  /** fill: covers its positioned parent (opening image, chapter breaks). */
  fit?: 'fill' | 'landscape' | 'portrait';
  tone?: 'dark' | 'light';
}
const { slot, fit = 'landscape', tone = 'light' } = Astro.props;
---

<div class:list={['photo-slot', `photo-slot--${fit}`, `photo-slot--${tone}`]} aria-hidden="true" data-slot={slot}>
  <span class="photo-slot-label">
    Photo: {slot}-landscape
    {fit === 'fill' && <><br />{slot}-portrait on phones</>}
  </span>
</div>

<style>
  .photo-slot {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-md);
    background:
      repeating-linear-gradient(135deg, rgba(255, 255, 255, 0.05) 0 12px, transparent 12px 24px),
      linear-gradient(160deg, #D9D3C2, #C4BCA6);
  }
  .photo-slot--dark {
    background:
      repeating-linear-gradient(135deg, rgba(255, 255, 255, 0.035) 0 14px, transparent 14px 28px),
      radial-gradient(ellipse at 70% 20%, #3D5560 0%, #16323D 45%, #0B242E 100%);
  }
  .photo-slot--landscape { aspect-ratio: 3 / 2; }
  .photo-slot--portrait { aspect-ratio: 4 / 5; }
  .photo-slot--fill {
    position: absolute;
    inset: 0;
    border-radius: 0;
  }
  .photo-slot-label {
    position: absolute;
    right: 0.75rem;
    top: 0.75rem;
    padding: 0.2rem 0.5rem;
    border-radius: var(--radius-sm);
    background: rgba(11, 36, 46, 0.55);
    color: #FFFFFF;
    font-family: ui-monospace, 'Cascadia Mono', Consolas, monospace;
    font-size: 0.7rem;
    line-height: 1.4;
    text-align: right;
  }
</style>
