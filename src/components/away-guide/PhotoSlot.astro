---
// One photograph slot in the away guide. A slot with a photograph in
// src/data/away-guide-photos.ts renders it as a <picture>: AVIF and WebP at
// several widths, a JPEG fallback, and the portrait crop served to phones
// where the slot has one (plan section 10). Any other slot renders a neutral
// block at the right aspect ratio, labelled with the slot name from
// docs/away-fans-guide-shot-list.md, so the layout can be judged.
//
// In a production build (the main branch, or AWAY_GUIDE_STRICT=1, the same
// rule as scripts/check-away-guide.mjs) an empty slot loses its label: a
// full-bleed slot keeps its plain dark background, and an inline one (a
// walking step) renders nothing.
//
// Slot names follow af-<chapter>-<subject>-<orientation>. Pass the name
// without the orientation.
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { AWAY_PHOTOS } from '../../data/away-guide-photos';

interface Props {
  slot: string;
  /** fill: covers its positioned parent (opening image, chapter breaks). */
  fit?: 'fill' | 'landscape' | 'portrait';
  tone?: 'dark' | 'light';
  /**
   * For fill: the frame's height on phones and on desktop, as CSS lengths.
   * A photo covering a frame wider or taller than itself is drawn larger
   * than the viewport width, so sizes has to allow for it.
   */
  heights?: { phone: string; desktop: string };
  /** The opening image: loaded at once and fetched first. */
  priority?: boolean;
}
const { slot, fit = 'landscape', tone = 'light', heights, priority = false } = Astro.props;
const photo = AWAY_PHOTOS[slot];
const production = process.env.CF_PAGES_BRANCH === 'main' || process.env.AWAY_GUIDE_STRICT === '1';

const BREAKPOINT = 900;
const WIDTHS = [640, 960, 1280, 1600, 2000, 2400];

const q = photo?.light ? { avif: 42, webp: 58 } : { avif: 60, webp: 72 };
async function srcset(src: ImageMetadata, format: 'avif' | 'webp') {
  const widths = WIDTHS.filter((w) => w < src.width).concat(src.width);
  const images = await Promise.all(widths.map((width) => getImage({ src, width, format, quality: q[format] })));
  return images.map((img, i) => `${img.src} ${widths[i]}w`).join(', ');
}
const ratio = (img: ImageMetadata) => (img.width / img.height).toFixed(3);
const coverSize = (img: ImageMetadata, height: string) => `max(100vw, calc(${height} * ${ratio(img)}))`;

let pic: {
  portrait?: { avif: string; webp: string; sizes: string };
  landscape: { avif: string; webp: string; sizes: string };
  fallback: string;
} | undefined;
if (photo) {
  const { landscape, portrait } = photo;
  const fill = fit === 'fill' && heights;
  pic = {
    portrait: portrait && {
      avif: await srcset(portrait, 'avif'),
      webp: await srcset(portrait, 'webp'),
      sizes: fill ? coverSize(portrait, heights.phone) : '100vw',
    },
    landscape: {
      avif: await srcset(landscape, 'avif'),
      webp: await srcset(landscape, 'webp'),
      sizes: fill
        ? (portrait
          ? coverSize(landscape, heights.desktop)
          : `(max-width: ${BREAKPOINT - 1}px) ${coverSize(landscape, heights.phone)}, ${coverSize(landscape, heights.desktop)}`)
        : `(max-width: ${BREAKPOINT - 1}px) 100vw, 40vw`,
    },
    fallback: (await getImage({ src: landscape, width: 1280, format: 'jpg', quality: 76 })).src,
  };
}
const phones = `(max-width: ${BREAKPOINT - 1}px)`;
---

{photo && pic ? (
  <picture class:list={['photo', `photo-slot--${fit}`]} data-slot={slot}>
    {pic.portrait && <source media={phones} type="image/avif" srcset={pic.portrait.avif} sizes={pic.portrait.sizes} />}
    {pic.portrait && <source media={phones} type="image/webp" srcset={pic.portrait.webp} sizes={pic.portrait.sizes} />}
    <source type="image/avif" srcset={pic.landscape.avif} sizes={pic.landscape.sizes} />
    <source type="image/webp" srcset={pic.landscape.webp} sizes={pic.landscape.sizes} />
    <img
      src={pic.fallback}
      width={photo.landscape.width}
      height={photo.landscape.height}
      alt={photo.alt}
      loading={priority ? 'eager' : 'lazy'}
      decoding="async"
      fetchpriority={priority ? 'high' : 'auto'}
      style={photo.position ? `object-position: ${photo.position}` : undefined}
    />
  </picture>
) : production ? (
  fit === 'fill' && <div class:list={['photo-slot', `photo-slot--${fit}`, `photo-slot--${tone}`, 'photo-slot--plain']} aria-hidden="true" data-slot={slot}></div>
) : (
  <div class:list={['photo-slot', `photo-slot--${fit}`, `photo-slot--${tone}`]} aria-hidden="true" data-slot={slot}>
    <span class="photo-slot-label">
      Photo: {slot}-landscape
      {fit === 'fill' && <><br />{slot}-portrait on phones</>}
    </span>
  </div>
)}

<style>
  .photo-slot {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-md);
    background:
      repeating-linear-gradient(135deg, rgba(255, 255, 255, 0.05) 0 12px, transparent 12px 24px),
      linear-gradient(160deg, #D9D3C2, #C4BCA6);
  }
  .photo-slot--dark {
    background:
      repeating-linear-gradient(135deg, rgba(255, 255, 255, 0.035) 0 14px, transparent 14px 28px),
      radial-gradient(ellipse at 70% 20%, #3D5560 0%, #16323D 45%, #0B242E 100%);
  }
  .photo-slot--plain { background: radial-gradient(ellipse at 70% 20%, #3D5560 0%, #16323D 45%, #0B242E 100%); }
  .photo-slot--landscape { aspect-ratio: 3 / 2; }
  .photo-slot--portrait { aspect-ratio: 4 / 5; }
  .photo-slot--fill {
    position: absolute;
    inset: 0;
    border-radius: 0;
  }
  .photo-slot-label {
    position: absolute;
    right: 0.75rem;
    top: 0.75rem;
    padding: 0.2rem 0.5rem;
    border-radius: var(--radius-sm);
    background: rgba(11, 36, 46, 0.55);
    color: #FFFFFF;
    font-family: ui-monospace, 'Cascadia Mono', Consolas, monospace;
    font-size: 0.7rem;
    line-height: 1.4;
    text-align: right;
  }
  .photo {
    display: block;
    overflow: hidden;
    border-radius: var(--radius-md);
  }
  .photo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .photo.photo-slot--fill { border-radius: 0; }
</style>
