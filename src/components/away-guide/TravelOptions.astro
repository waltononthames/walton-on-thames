---
// Comparison card: the four ways from Walton-on-Thames station to the ground,
// side by side, with equal weight (plan D11). The walk is long, so bus and
// taxi are presented as equals of the two walking routes, not as footnotes.
// Plain HTML; each card links to its detail further down.
import Fact from './Fact.astro';
import Icon from './Icon.astro';
import { shows, valueOf, type Fact as FactT } from '../../utils/awayGuide';

interface WalkRoute {
  variant: string;
  title: string;
  metres: number;
  minutes: number;
  bestFor: FactT<string>;
  lighting: FactT<string>;
  afterDark: FactT<string>;
}
interface Props {
  walks: WalkRoute[];
  bus: {
    route: FactT<string>;
    journeyMins: FactT<number>;
    walkFromStopMins: FactT<number>;
    frequency: FactT<string>;
  };
  driveMins: number;
  rideHailing: string[];
}
const { walks, bus, driveMins, rideHailing } = Astro.props;
const km = (m: number) => (m / 1000).toFixed(1);
const busMins = (valueOf(bus.journeyMins) ?? 0) + (valueOf(bus.walkFromStopMins) ?? 0);
const busSample = 'placeholder' in bus.journeyMins || 'placeholder' in bus.walkFromStopMins;
const taxiLabel = ['Taxi', ...rideHailing].join(' or ');
---

<ul class="options" aria-label="Ways to get from Walton-on-Thames station to the ground">
  {walks.map((w) => (
    <li class="option">
      <p class="option-mode"><Icon name={w.variant === 'towpath' ? 'river' : 'walk'} /> Walk {w.title.replace(/^By/, 'by')}</p>
      <p class="option-time">About {w.minutes} minutes</p>
      <p class="option-sub">{km(w.metres)} km on foot</p>
      <dl>
        {shows(w.lighting) && <div><dt>Lighting</dt><dd><Fact f={w.lighting} /></dd></div>}
        {shows(w.afterDark) && <div><dt>After dark</dt><dd><Fact f={w.afterDark} /></dd></div>}
        {shows(w.bestFor) && <div><dt>Best for</dt><dd><Fact f={w.bestFor} /></dd></div>}
      </dl>
      <a class="option-link" href="#route-choice">See the route</a>
    </li>
  ))}

  <li class="option">
    <p class="option-mode"><Icon name="bus" /> Bus</p>
    {busMins > 0 && (
      <p class="option-time">
        About {busMins} minutes{busSample && <span class="option-sample">Sample</span>}
      </p>
    )}
    <p class="option-sub">Route <Fact f={bus.route} /></p>
    <dl>
      {shows(bus.frequency) && <div><dt>How often</dt><dd><Fact f={bus.frequency} /></dd></div>}
      <div><dt>Includes</dt><dd>The walk from the bus stop to the ground</dd></div>
    </dl>
    <a class="option-link" href="#by-bus">Bus details</a>
  </li>

  <li class="option">
    <p class="option-mode"><Icon name="taxi" /> {taxiLabel}</p>
    <p class="option-time">About {driveMins} minutes</p>
    <p class="option-sub">Typical drive time with light traffic</p>
    <dl>
      <div><dt>After the match</dt><dd>Book or request a car early, as many people leave at once</dd></div>
    </dl>
    <a class="option-link" href="#by-taxi">Taxi and {rideHailing.join(' and ') || 'car'} details</a>
  </li>
</ul>

<style>
  .options {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 1rem;
    margin: 1.5rem 0 2rem;
    list-style: none;
  }
  .option {
    display: flex;
    flex-direction: column;
    padding: 1.1rem 1.2rem;
    border-radius: var(--radius-md);
    background: var(--color-white);
    box-shadow: var(--shadow-card);
    border-top: 4px solid var(--color-navy);
  }
  .option-mode {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--color-slate);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .option-mode :global(.icon) { color: var(--color-accent); }
  .option-time {
    margin-top: 0.35rem;
    font-family: var(--font-heading);
    font-size: 1.6rem;
    font-weight: 700;
    line-height: 1.2;
  }
  .option-sub { color: var(--color-slate); font-size: 0.9rem; }
  .option-sample {
    margin-left: 0.4rem;
    padding: 0 0.4em;
    border-radius: 999px;
    background: #FCE9C2;
    color: #6B4A10;
    font: 600 0.62rem var(--font-body);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    vertical-align: 0.3em;
  }
  dl { margin: 0.75rem 0; flex: 1; }
  dl div { padding: 0.4rem 0; border-top: 1px solid rgba(11, 36, 46, 0.07); }
  dt { color: var(--color-slate); font-size: 0.75rem; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; }
  dd { font-size: 0.92rem; line-height: 1.45; }
  .option-link {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 600;
    font-size: 0.9rem;
  }
</style>
