---
// Last-train finder (brief 7.5). Walton-on-Thames station only, because the
// leave-by times depend on the walking routes (plan D9).
//
// Shows the trains a fan can actually catch after full time, plus the last
// train each way, for the chosen day and way of getting back to the station.
// The HTML is a plain table per day (walking by road), complete without
// JavaScript; the script adds the choice of day and mode. Both use the same
// arithmetic, in src/utils/trainTimes.ts.
//
// Timetables change, usually in May and December. Each record carries the
// period it was checked against; once that period ends the finder is not
// rendered in a production build, and only the National Rail links remain.
import { londonToday, longDate, valueOf, PLATFORM_ALLOWANCE_MINS, type Fact, type TrainData } from '../../utils/awayGuide';
import { clockFromMinutes, plan, serviceMinutes, type FinderData } from '../../utils/trainTimes';

interface Props {
  trains: TrainData[];
  kickOff: { saturday: number | null; weekday: number | null };
  walk: { road: number; towpath: number };
  towpathAfterDark?: string;
  driveMins: number;
  bus: {
    route?: string;
    fromGround: { saturday: Fact<string[]>; weekday: Fact<string[]> };
    fromGroundMins?: number;
    groundToStop: number;
    stopToStation: number;
  };
  taxiLabel: string;
}
const { trains, kickOff, walk, towpathAfterDark, driveMins, bus, taxiLabel } = Astro.props;

const today = londonToday();
const live = trains.filter((t) => t.departures.timetableValidTo >= today);
const records = import.meta.env.DEV ? trains : live;
const show = records.length > 0;
const sample = records.some((t) => 'placeholder' in t.departures);
const validTo = records.map((t) => t.departures.timetableValidTo).sort()[0];
const checked = records.flatMap((t) => ('source' in t.departures ? [t.departures.source.checked] : [])).sort()[0];

const days = [
  { key: 'saturday', label: 'Saturday' },
  { key: 'weekday', label: 'Midweek' },
] as const;

const data: FinderData = {
  allowance: PLATFORM_ALLOWANCE_MINS,
  kickOff,
  walk,
  driveMins,
  bus: {
    fromGround: { saturday: valueOf(bus.fromGround.saturday) ?? [], weekday: valueOf(bus.fromGround.weekday) ?? [] },
    fromGroundMins: bus.fromGroundMins ?? null,
    groundToStop: bus.groundToStop,
    stopToStation: bus.stopToStation,
  },
  trains: Object.fromEntries(days.map((d) => [
    d.key,
    records.filter((t) => t.dayType === d.key).flatMap((t) => t.departures.times.map((time) => ({ time, direction: t.direction }))),
  ])),
};
const busRuns = data.bus.fromGround.saturday.length + data.bus.fromGround.weekday.length > 0 && data.bus.fromGroundMins != null;
---

{show && (
  <div class="finder" data-finder>
    <p class="finder-meta">
      {sample
        ? <><span class="finder-sample">Sample times</span> These are not real departures.</>
        : <>Train times from Realtime Trains, checked {checked && longDate(checked)} against the timetable that runs until {longDate(validTo)}. Engineering work can change them on the day.</>}
      {' '}Always check live times before you set off.
    </p>

    <div class="finder-tool" hidden>
      <form class="finder-form" onsubmit="return false">
        <fieldset>
          <legend>Day</legend>
          {days.map((d, i) => (
            <label><input type="radio" name="finder-day" value={d.key} checked={i === 0} /> {d.label}</label>
          ))}
        </fieldset>
        <fieldset>
          <legend>Getting back to the station</legend>
          <label><input type="radio" name="finder-mode" value="road" checked /> Walk by road</label>
          <label><input type="radio" name="finder-mode" value="towpath" /> Walk by the river</label>
          {busRuns && <label><input type="radio" name="finder-mode" value="bus" /> Bus{bus.route && ` ${bus.route}`}</label>}
          <label><input type="radio" name="finder-mode" value="taxi" /> {taxiLabel}</label>
        </fieldset>
      </form>
      <p class="finder-note" data-finder-note></p>
      <ol class="finder-results" data-finder-results aria-live="polite"></ol>
    </div>

    <div class="finder-static">
      {days.map((d) => {
        const { fullTime, rows } = plan(data, d.key, 'road');
        return rows.length > 0 && (
          <table>
            <caption>
              {d.label}: trains after the match, walking back by road
              {fullTime != null && <span class="caption-sub">Full time is usually around {clockFromMinutes(fullTime)}</span>}
            </caption>
            <thead>
              <tr>
                <th scope="col">Leave the ground by</th>
                <th scope="col">Train departs</th>
                <th scope="col">Towards</th>
              </tr>
            </thead>
            <tbody>
              {rows.map((r) => (
                <tr>
                  <td>{clockFromMinutes(r.leaveBy)}</td>
                  <td>{clockFromMinutes(serviceMinutes(r.train.time))}{r.last && <span class="last"> last train</span>}</td>
                  <td>{r.train.direction}</td>
                </tr>
              ))}
            </tbody>
          </table>
        );
      })}
      <p class="finder-foot">
        Leave-by times allow about {walk.road} minutes to walk by road and {PLATFORM_ALLOWANCE_MINS} minutes to reach the platform. With JavaScript on, you can choose the river walk, the bus or a car instead.
      </p>
    </div>

    <script is:inline type="application/json" data-finder-data set:html={JSON.stringify({ ...data, towpathAfterDark: towpathAfterDark ?? null, busRoute: bus.route ?? null })} />
  </div>
)}

<script>
  import '../../scripts/away-guide/last-train';
</script>

<style>
  .finder {
    padding: 1.25rem;
    border-radius: var(--radius-lg);
    background: var(--color-white);
    box-shadow: var(--shadow-card);
  }
  .finder-meta { margin-bottom: 1rem; font-size: 0.9rem; color: var(--color-slate); }
  .finder-sample {
    margin-right: 0.35rem;
    padding: 0.05rem 0.5rem;
    border-radius: 999px;
    background: #FCE9C2;
    color: #6B4A10;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  table {
    width: 100%;
    margin-bottom: 1.25rem;
    border-collapse: collapse;
    font-size: 0.92rem;
  }
  caption {
    margin-bottom: 0.4rem;
    text-align: left;
    font-weight: 600;
  }
  .caption-sub { display: block; font-weight: 400; font-size: 0.85rem; color: var(--color-slate); }
  th, td {
    padding: 0.5rem 0.4rem;
    border-bottom: 1px solid rgba(11, 36, 46, 0.08);
    text-align: left;
    vertical-align: top;
  }
  th { color: var(--color-slate); font-size: 0.75rem; font-weight: 600; }
  td:first-child { font-weight: 700; font-variant-numeric: tabular-nums; }
  .last { color: var(--color-slate); font-size: 0.8rem; font-weight: 600; }
  .finder-foot { font-size: 0.85rem; color: var(--color-slate); }

  .finder-form {
    display: grid;
    gap: 1rem;
    margin-bottom: 1rem;
  }
  @media (min-width: 700px) {
    .finder-form { grid-template-columns: auto 1fr; gap: 2rem; }
  }
  fieldset { border: 0; }
  legend {
    margin-bottom: 0.4rem;
    color: var(--color-slate);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  fieldset label {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 44px;
    margin: 0 0.35rem 0.35rem 0;
    padding: 0 0.9rem;
    border: 1.5px solid rgba(11, 36, 46, 0.2);
    border-radius: 999px;
    cursor: pointer;
    font-size: 0.9rem;
  }
  fieldset label:has(input:checked) {
    border-color: var(--color-navy);
    background: var(--color-navy);
    color: #FFFFFF;
  }
  fieldset label:has(input:focus-visible) { outline: 2px solid var(--color-accent); outline-offset: 2px; }
  fieldset input { accent-color: var(--color-accent); }
  .finder-note { margin-bottom: 0.75rem; font-size: 0.88rem; color: var(--color-slate); }
  .finder-note:empty { display: none; }
  .finder-results { list-style: none; display: grid; gap: 0.5rem; }
  .finder-results :global(li) {
    display: grid;
    grid-template-columns: 5.5rem 1fr;
    gap: 0.2rem 1rem;
    padding: 0.75rem 1rem;
    border-radius: var(--radius-md);
    background: #FBF8EE;
  }
  .finder-results :global(.leave) { font-family: var(--font-heading); font-size: 1.35rem; font-weight: 700; }
  .finder-results :global(.train) { align-self: center; }
  .finder-results :global(.none) { grid-column: 1 / -1; color: var(--color-slate); }
</style>
