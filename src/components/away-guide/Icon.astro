---
// Line icons for the away guide's Need to know panels. Inline SVG, so no icon
// font or extra request. Decorative: the label beside each icon carries the
// meaning, so every icon is aria-hidden.
interface Props {
  name: 'pin' | 'clock' | 'ticket' | 'train' | 'car' | 'shield' | 'walk' | 'river' | 'bus' | 'taxi' | 'pint' | 'moon' | 'step' | 'info' | 'food';
  size?: number;
}
const { name, size = 22 } = Astro.props;
const paths: Record<Props['name'], string> = {
  pin: 'M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11z M12 12.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5z',
  clock: 'M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18z M12 7v5l3.5 2',
  ticket: 'M3.5 8.5V6h17v2.5a2.5 2.5 0 0 0 0 5V16h-17v-2.5a2.5 2.5 0 0 0 0-5z M14 6v10',
  train: 'M7 3.5h10a2 2 0 0 1 2 2V15a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V5.5a2 2 0 0 1 2-2z M5 10.5h14 M8.5 14h.01 M15.5 14h.01 M8 17l-2 3.5 M16 17l2 3.5',
  car: 'M5 16.5V12l2-5h10l2 5v4.5 M3.5 16.5h17 M7.5 16.5V19 M16.5 16.5V19 M5 12h14',
  shield: 'M12 3l7.5 3v5.5c0 4.5-3.2 8-7.5 9.5-4.3-1.5-7.5-5-7.5-9.5V6z',
  walk: 'M13 4.5a1.5 1.5 0 1 0 0-.01 M10 21l2.5-6.5L15 17v4 M8 11l3-3.5 3 2 2.5 3 M12.5 14.5l-1-6',
  river: 'M3 8c3-2 6 2 9 0s6-2 9 0 M3 13c3-2 6 2 9 0s6-2 9 0 M3 18c3-2 6 2 9 0s6-2 9 0',
  bus: 'M6 3.5h12a1.5 1.5 0 0 1 1.5 1.5v11.5H4.5V5A1.5 1.5 0 0 1 6 3.5z M4.5 11h15 M7.5 19.5v-3 M16.5 19.5v-3 M8 14h.01 M16 14h.01',
  taxi: 'M5 16V12l2-4.5h10L19 12v4 M3.5 16h17 M7.5 16v3 M16.5 16v3 M9.5 7.5L10 4.5h4l.5 3 M5 12h14',
  pint: 'M7 4h10l-1.3 16H8.3z M7.4 9h9.2',
  moon: 'M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z',
  step: 'M4 19h5v-5h5V9h6',
  food: 'M7 3v7a2 2 0 0 0 2 2v9 M5 3v5 M9 3v5 M17 21V3c-2.2 1.2-3.5 4-3.5 8H17',
  info: 'M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18z M12 11v6 M12 7.5h.01',
};
---

<svg class="icon" width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  <path d={paths[name]} />
</svg>
