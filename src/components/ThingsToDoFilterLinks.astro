---
// Filter-link block, brief section 6.3/6.4: plain crawlable anchors to the
// eight static filter pages plus the Hersham page (nine chips total), 
// no client-side filtering, so this works with JavaScript disabled and
// each destination is its own indexable, rankable page.
const chips = [
  { href: '/things-to-do/free/', label: 'Free' },
  { href: '/things-to-do/families/', label: 'Families' },
  { href: '/things-to-do/rainy-days/', label: 'Rainy days' },
  { href: '/things-to-do/on-the-water/', label: 'On the water' },
  { href: '/things-to-do/heritage-and-culture/', label: 'Heritage & culture' },
  { href: '/things-to-do/parks-and-walks/', label: 'Parks & walks' },
  { href: '/things-to-do/sport-and-active/', label: 'Sport & active' },
  { href: '/things-to-do/annual-events/', label: 'Annual events' },
  { href: '/things-to-do/hersham/', label: 'Things to do in Hersham', accent: true },
];

const currentPath = Astro.url.pathname;
---

<nav aria-label="Filter things to do by category" class="filter-links">
  <ul class="filter-links-track" role="list">
    {chips.map((chip) => (
      <li>
        <a
          href={chip.href}
          class:list={['filter-chip', { 'filter-chip--accent': chip.accent }]}
          aria-current={currentPath === chip.href ? 'page' : undefined}
        >
          {chip.label}
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
  .filter-links {
    position: relative;
  }

  .filter-links-track {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    list-style: none;
  }

  .filter-chip {
    display: inline-block;
    padding: 0.45rem 1rem;
    border-radius: 999px;
    background: var(--color-white);
    border: 1.5px solid rgba(11, 36, 46, 0.15);
    color: var(--color-navy);
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    transition: border-color 0.15s, background-color 0.15s, color 0.15s;
  }

  .filter-chip:hover {
    border-color: var(--color-accent);
    color: var(--color-accent-dark);
  }

  .filter-chip[aria-current='page'] {
    background: var(--color-navy);
    border-color: var(--color-navy);
    color: var(--color-white);
  }

  .filter-chip--accent {
    border-color: var(--color-accent);
    color: var(--color-accent-dark);
  }

  /* Mobile: horizontal scroll with a visible fade to signal more content,
     rather than wrapping into a wall of chips (section 6.4). */
  @media (max-width: 640px) {
    .filter-links-track {
      flex-wrap: nowrap;
      overflow-x: auto;
      scroll-snap-type: x proximity;
      padding-bottom: 0.25rem;
      -webkit-overflow-scrolling: touch;
    }

    .filter-links-track li {
      scroll-snap-align: start;
    }

    .filter-links::after {
      content: '';
      position: absolute;
      top: 0;
      right: 0;
      bottom: 0.25rem;
      width: 2.5rem;
      background: linear-gradient(to right, transparent, var(--color-cream));
      pointer-events: none;
    }
  }
</style>
