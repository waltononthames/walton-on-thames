---
// Focused map of one surgery. The building point and the entrance are kept
// apart: the entrance marker only appears once an entrance has been observed
// or confirmed (gp.entrance in the listing). The address and a directions
// link sit outside the map, so they work when the image doesn't.
import type { CollectionEntry } from 'astro:content';
import { localBaseFor, project, cropAround, baseImageStyle, MAP_VERSION } from './mapProjection';

interface Props { practice: CollectionEntry<'businesses'> }
const { practice } = Astro.props;
const d = practice.data;
const base = localBaseFor(d.slug);
const building = { lat: d.lat!, lng: d.lng! };
const entrance = d.gp?.entrance;
const crop = base ? cropAround(base, entrance ? [building, entrance] : [building], 330, 1.4) : null;
const R = crop ? crop.w * 0.022 : 0;
const b = base ? project(base, building) : null;
const e = base && entrance ? project(base, entrance) : null;
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(`${d.name}, ${d.address}`)}`;
---

<figure class="localmap">
  {base && crop && b && (
    <div class="gpmap" style={`aspect-ratio:${crop.w} / ${crop.h}`}>
      <img class="gpmap-base" src={`${base.src}?v=${MAP_VERSION}`} alt="" loading="lazy" decoding="async" width={base.width} height={base.height} style={baseImageStyle(base, crop)} />
      <svg class="gpmap-overlay" viewBox={`${crop.x} ${crop.y} ${crop.w} ${crop.h}`} role="img" aria-label={`Street map around ${d.name}, ${d.address}${entrance ? ', with its entrance marked' : ''}`}>
        <g class="localmap-building">
          <path d={`M${b.x} ${b.y}c${-R * 0.25} ${-R * 0.55} ${-R} ${-R * 1.1} ${-R} ${-R * 1.85}a${R} ${R} 0 1 1 ${R * 2} 0c0 ${R * 0.75} ${-R * 0.75} ${R * 1.3} ${-R} ${R * 1.85}z`} stroke-width={R * 0.14} />
          <circle cx={b.x} cy={b.y - R * 1.85} r={R * 0.38} />
        </g>
        {e && (
          <g class="localmap-entrance">
            <rect x={e.x - R * 0.6} y={e.y - R * 0.6} width={R * 1.2} height={R * 1.2} stroke-width={R * 0.14} />
            <text x={e.x + R * 0.9} y={e.y} font-size={R * 0.9} dominant-baseline="central">Entrance</text>
          </g>
        )}
      </svg>
    </div>
  )}
  <figcaption>
    <p><strong>{d.name}</strong>, {d.address}. The pin is placed from: {d.gp?.building_point_source.label.replace(/\.$/, '')}.{!entrance && ' It marks the location, not a particular door.'}</p>
    <p><a href={directionsUrl} rel="noopener noreferrer" target="_blank">Get directions (Google Maps)<span class="sr-only"> (external site, opens in a new tab)</span></a></p>
    <p class="localmap-credit">Base map © <a href="https://www.openstreetmap.org/copyright" rel="noopener noreferrer" target="_blank">OpenStreetMap contributors</a> (ODbL). <a href="https://www.openstreetmap.org/fixthemap" rel="noopener noreferrer" target="_blank">Report a map error</a>.</p>
  </figcaption>
</figure>

<style>
  .localmap { margin: 0; }
  .gpmap {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
    background: #F3F0E4;
  }
  .gpmap-base { position: absolute; max-width: none; height: auto; }
  .gpmap-overlay { position: absolute; inset: 0; width: 100%; height: 100%; }
  .localmap-building path { fill: #B5543C; stroke: #FFFFFF; }
  .localmap-building circle { fill: #FFFFFF; }
  .localmap-entrance rect { fill: var(--color-navy); stroke: #FFFFFF; }
  .localmap-entrance text { fill: var(--color-navy); font-weight: 700; font-family: var(--font-body); paint-order: stroke; stroke: #F3F0E4; stroke-width: 4px; }
  .localmap figcaption { font-size: 0.875rem; color: var(--color-slate); margin-top: 0.6rem; }
  .localmap figcaption p { margin: 0 0 0.35rem; }
  .localmap figcaption a { color: var(--color-navy); }
  .localmap-credit, .localmap-credit a { font-size: 0.8rem; color: var(--color-slate) !important; }
</style>
