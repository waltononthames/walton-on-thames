---
// Sticky in-page navigation, brief section 6.3/6.6. Two distinct devices,
// not one component shown two ways:
//  - Desktop: a slim bar (<=56px tall) that fades in once the reader has
//    scrolled roughly past the hero, linking to each major section/band.
//  - Mobile: a static "On this page" <details> disclosure near the top
//    (native, so it's keyboard/screen-reader accessible for free) plus a
//    floating back-to-top button that appears after two viewport heights.
// Both respect prefers-reduced-motion by skipping smooth-scroll/transition.
interface Section {
  id: string;
  label: string;
}

interface Props {
  sections: Section[];
}

const { sections } = Astro.props;
---

<nav aria-label="Page sections" class="stdn-desktop-bar" id="things-to-do-sticky-nav" inert>
  <ul class="stdn-list" role="list">
    {sections.map((s) => (
      <li><a href={`#${s.id}`}>{s.label}</a></li>
    ))}
  </ul>
</nav>

<details class="stdn-mobile-disclosure">
  <summary>On this page</summary>
  <ul class="stdn-list" role="list">
    {sections.map((s) => (
      <li><a href={`#${s.id}`}>{s.label}</a></li>
    ))}
  </ul>
</details>

<button type="button" class="stdn-back-to-top" id="things-to-do-back-to-top" aria-label="Back to top" inert>
  <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 13V3M3.5 7.5 8 3l4.5 4.5"/></svg>
</button>

<script is:inline>
  (function () {
    function init() {
      var bar = document.getElementById('things-to-do-sticky-nav');
      var backToTop = document.getElementById('things-to-do-back-to-top');
      if (!bar || !backToTop) return;

      var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var HERO_THRESHOLD = 420;
      var BACK_TO_TOP_THRESHOLD = window.innerHeight * 2;
      var ticking = false;

      function update() {
        var y = window.scrollY;
        var barVisible = y > HERO_THRESHOLD;
        var backToTopVisible = y > BACK_TO_TOP_THRESHOLD;

        bar.classList.toggle('is-visible', barVisible);
        backToTop.classList.toggle('is-visible', backToTopVisible);

        // Keep invisible (opacity:0) elements out of the tab order, without
        // this, a keyboard user tabbing early lands on links they can't see.
        bar.toggleAttribute('inert', !barVisible);
        backToTop.toggleAttribute('inert', !backToTopVisible);

        ticking = false;
      }

      window.addEventListener('scroll', function () {
        if (!ticking) {
          window.requestAnimationFrame(update);
          ticking = true;
        }
      }, { passive: true });

      window.addEventListener('resize', function () {
        BACK_TO_TOP_THRESHOLD = window.innerHeight * 2;
      });

      backToTop.addEventListener('click', function () {
        window.scrollTo({ top: 0, behavior: reduceMotion ? 'auto' : 'smooth' });
        document.body.focus?.();
      });

      update();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>

<style>
  .stdn-list {
    list-style: none;
    display: flex;
    gap: 1.5rem;
  }

  .stdn-list a {
    color: var(--color-navy);
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 600;
    white-space: nowrap;
  }

  .stdn-list a:hover {
    color: var(--color-accent-dark);
  }

  /* Desktop sticky bar: hidden until scrolled, capped at 56px, fades/slides
     in unless the reader prefers reduced motion. */
  .stdn-desktop-bar {
    display: none;
  }

  @media (min-width: 769px) {
    .stdn-desktop-bar {
      display: block;
      position: fixed;
      top: var(--nav-height, 72px);
      left: 0;
      right: 0;
      z-index: 90;
      height: 48px;
      max-height: 56px;
      background: var(--color-white);
      border-bottom: 1px solid rgba(11, 36, 46, 0.1);
      box-shadow: var(--shadow-card);
      overflow-x: auto;
      opacity: 0;
      transform: translateY(-8px);
      pointer-events: none;
      transition: opacity 0.2s ease, transform 0.2s ease;
    }

    .stdn-desktop-bar.is-visible {
      opacity: 1;
      transform: translateY(0);
      pointer-events: auto;
    }

    .stdn-desktop-bar .stdn-list {
      height: 48px;
      align-items: center;
      padding: 0 1.5rem;
      max-width: var(--max-width);
      margin: 0 auto;
    }

    .stdn-mobile-disclosure {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .stdn-desktop-bar {
      transition: none;
    }
  }

  /* Mobile: static collapsible disclosure, no scroll-linked behaviour. */
  .stdn-mobile-disclosure {
    background: var(--color-white);
    border: 1px solid rgba(11, 36, 46, 0.12);
    border-radius: var(--radius-md);
    padding: 0.75rem 1rem;
    margin-bottom: 1.5rem;
  }

  .stdn-mobile-disclosure summary {
    cursor: pointer;
    font-weight: 600;
    font-family: var(--font-heading);
    color: var(--color-navy);
  }

  .stdn-mobile-disclosure .stdn-list {
    flex-direction: column;
    gap: 0.6rem;
    margin-top: 0.75rem;
    padding-left: 0.25rem;
  }

  /* Floating back-to-top, both breakpoints. */
  .stdn-back-to-top {
    position: fixed;
    right: 1rem;
    bottom: 1rem;
    z-index: 90;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--color-navy);
    color: var(--color-white);
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    opacity: 0;
    transform: translateY(8px);
    pointer-events: none;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .stdn-back-to-top.is-visible {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .stdn-back-to-top:hover {
    background: var(--color-navy-ink);
  }

  @media (prefers-reduced-motion: reduce) {
    .stdn-back-to-top {
      transition: none;
    }
  }
</style>
