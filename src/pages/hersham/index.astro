---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { HERSHAM_GREEN_HERO } from '../../utils/hero-images';
import { HERSHAM_PLACE_ID, SITE_ID } from '../../utils/schema';
import EventCard from '../../components/EventCard.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

// getCollection's entries do not infer through the chained callbacks below,
// so every parameter would otherwise report ts(7006).
type EventEntry = CollectionEntry<'events'>;

// Upcoming Hersham events. /whats-on/ is site-wide and unfiltered, so this is
// the only place a visitor can see Hersham's listings on their own. It is also
// the hub's only genuinely fresh block: the nightly rebuild drops lapsed events
// without an edit.
const _today = new Date();
_today.setHours(0, 0, 0, 0);
const hershamEvents = (await getCollection('events'))
  .filter((e: EventEntry) => e.data.neighbourhood === 'hersham')
  .filter((e: EventEntry) => {
    const d = new Date(e.data.end ?? e.data.start);
    d.setHours(0, 0, 0, 0);
    return d >= _today;
  })
  .sort((a: EventEntry, b: EventEntry) => new Date(a.data.start).getTime() - new Date(b.data.start).getTime())
  .slice(0, 3);

// The FAQ block specified in extension 4.1, held as data so the visible markup
// and the FAQPage JSON-LD cannot drift apart.
const faqs = [
  {
    q: 'Is Hersham part of Walton-on-Thames?',
    a: 'Hersham is a distinct village with its own parish history, formed out of Walton in 1851, and the two now share a post town and a borough council rather than a single identity.',
  },
  {
    q: 'Is Hersham a nice place to live?',
    a: 'Hersham combines a genuine village green and easy access to the River Mole with fast rail links to London, which is the main reason it consistently attracts people weighing up a move from further into the city.',
  },
  {
    q: 'What is Hersham famous for?',
    a: 'Hersham is best known locally for its green, its River Mole meadows, its parakeet colony, and for producing the punk band Sham 69, whose biggest hit is named directly after the village.',
  },
  {
    q: 'Where do the Hersham parakeets roost?',
    a: 'The best-documented roost is near Esher Rugby Club, on the edge of Hersham, where mid-2000s reporting put the colony at around 7,000 birds.',
    // Rendered as its own paragraph beneath the answer, and deliberately kept
    // out of the FAQPage answer text: it points the reader onward rather than
    // answering the question, so the schema answer stays the factual sentence.
    followOn: {
      lead: 'For where and when to see the birds, see our ',
      href: '/hersham/parakeets/',
      label: 'full guide to the Hersham parakeets',
      tail: '.',
    },
  },
  {
    q: 'What is the population of Hersham?',
    a: 'The 2021 census recorded 12,630 people in the Hersham built-up area, up from 11,260 in 2011.',
  },
  {
    // Two-tier local government is a genuine source of confusion and the fact
    // box above can only name the borough, not explain the split. Elmbridge's
    // own site covers Hersham's bins, parks and planning records, and the
    // village sits in its Hersham Village ward; Surrey County Council runs
    // Hersham Library and the schools this site already cites it for.
    q: 'Which council covers Hersham?',
    a: 'Two, for now. Elmbridge Borough Council covers bins, planning and parks, and Hersham sits in its Hersham Village ward, while Surrey County Council covers schools, libraries and roads. Both are replaced on 1 April 2027 by East Surrey Council, a single unitary authority.',
  },
  {
    // Journey time and calling pattern from National Rail live departures,
    // verified 26 August 2026 and already published with sources on
    // /hersham-railway-station/. Deliberately a journey time rather than a
    // distance, which is what people actually mean by this question.
    q: 'How far is Hersham from London?',
    a: 'Hersham station is 33 minutes from London Waterloo, with two trains an hour. There is no faster option: the two fast lines through the middle of the station have no platforms, so every London train is a stopping service.',
  },
];

// The "Hersham at a glance" fact box below. Sources for every value, all
// checked 4 September 2026:
//   County, borough, post town: Elmbridge Borough Council is the local
//     authority and Walton-on-Thames is the post town on every verified
//     Hersham address in src/content/businesses/.
//   Borough ward "Hersham Village": Elmbridge Borough Council's own councillor
//     index, grouped by ward, at mygov.elmbridge.gov.uk/mgMemberIndex.aspx
//     (FN=WARD). Hersham North and Hersham South are no longer current wards;
//     they were replaced by the single Hersham Village ward.
//   Constituency "Esher and Walton": UK Parliament, constituency in existence
//     from 31 May 2024 (electionresults.parliament.uk/constituency-areas/867).
//     The 2023 Boundary Commission review placed the Hersham Village ward in
//     it. /living/ already publishes the same constituency for Walton.
//   Postcode district KT12: every Hersham business address verified on this
//     site sits in KT12 (sectors KT12 4 and KT12 5), so the district is stated
//     and no single postcode is, because the village spans two sectors.
//   Population: ONS, Census 2021 built-up areas, Hersham (E63005239), the same
//     figure already cited in the page intro.
//   Council from 2027: government confirmed the two-unitary model for Surrey
//     on 28 October 2025, shadow elections were held 7 May 2026 and the new
//     authority takes power on 1 April 2027 (Surrey County Council news, and
//     Elmbridge Borough Council's reorganisation updates). Already published
//     on /living/, /hersham/living/ and both development-and-planning pages;
//     added here so the hub does not contradict them.
// Deliberately a data block, not prose: the hub's prose stays inside the 900
// to 1,100 word band set by the extension amendment.

// Extension 4.1 calls for a hub link grid. Deliberately compact links rather
// than cards: the full card treatment belongs to the spokes
// (/things-to-do/hersham/, /hersham/food-and-drink/, /hersham/history/), per the
// duplication controls documented at the top of things-to-do/hersham.astro.
const exploreGroups = [
  {
    heading: 'Village life',
    links: [
      { href: '/hersham/hersham-green/', label: 'Hersham Green' },
      { href: '/hersham/living/', label: 'Living in Hersham' },
      { href: '/hersham/community-groups/', label: 'Community groups' },
      { href: '/hersham/development-and-planning/', label: 'Development and planning' },
      { href: '/hersham/food-and-drink/', label: 'Food and drink' },
      { href: '/hersham/hersham-green-shopping-centre/', label: 'Hersham Green Shopping Centre' },
      { href: '/things-to-do/hersham/', label: 'Things to do in Hersham' },
      { href: '/things-to-do/hersham-recreation-ground/', label: 'Hersham Recreation Ground' },
      { href: '/things-to-do/coronation-recreation-ground-hersham/', label: 'Coronation Recreation Ground' },
    ],
  },
  {
    heading: 'History and heritage',
    links: [
      { href: '/hersham/history/', label: 'Hersham history' },
      { href: '/hersham/st-peters-church/', label: "St Peter's Church" },
      { href: '/hersham/hersham-lodge-and-hersham-place/', label: 'Hersham Lodge and Hersham Place' },
      { href: '/hersham/queen-victoria-first-steam-train/', label: "Queen Victoria's first steam train" },
      { href: '/history/abc-motors-hersham/', label: 'ABC Motors' },
      { href: '/hersham/famous-residents/', label: 'Famous residents' },
      { href: '/hersham/sham-69/', label: 'Sham 69' },
    ],
  },
  {
    heading: 'Outdoors and sport',
    links: [
      { href: '/hersham/river-mole-walks/', label: 'River Mole walks' },
      { href: '/hersham/parakeets/', label: 'The Hersham parakeets' },
      { href: '/hersham/burhill-and-golf/', label: 'Burhill and golf' },
      { href: '/things-to-do/walton-and-hersham-fc/', label: 'Walton & Hersham FC' },
      { href: '/hersham/whiteley-village/', label: 'Whiteley Village' },
    ],
  },
  {
    heading: 'Getting around',
    links: [
      { href: '/hersham-railway-station/', label: 'Hersham station' },
      { href: '/walton-on-thames-railway-station/', label: 'Walton-on-Thames station' },
    ],
  },
];
---

<BaseLayout
  title="Hersham Village, Surrey"
  description="A local guide to Hersham, Surrey: the green, food and drink, walks by the River Mole, history from the Domesday era to Sham 69, and village life."
  image="/images/hersham-green-village-sign-hero.webp"
  preloadImage={{ srcset: HERSHAM_GREEN_HERO.srcset, sizes: HERSHAM_GREEN_HERO.sizes }}
>
  <slot name="structured-data">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Place",
      "@id": HERSHAM_PLACE_ID,
      "name": "Hersham",
      "alternateName": "Hersham Village",
      "description": "A village in the Borough of Elmbridge, Surrey, between Walton-on-Thames and Esher.",
      "url": "https://walton-on-thames.org/hersham/",
      "image": "https://walton-on-thames.org/images/hersham-green-village-sign-hero.webp",
      // Hersham Green, the centre of the village, from the audited coordinate
      // in src/content/places/hersham-village-green.md.
      "geo": { "@type": "GeoCoordinates", "latitude": 51.3662, "longitude": -0.4002 },
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Hersham",
        "addressRegion": "Surrey",
        "addressCountry": "GB"
      },
      "containedInPlace": {
        "@type": "AdministrativeArea",
        "name": "Borough of Elmbridge",
        "containedInPlace": { "@type": "AdministrativeArea", "name": "Surrey" }
      },
      "hasMap": "https://www.openstreetmap.org/?mlat=51.3662&mlon=-0.4002#map=16/51.3662/-0.4002",
      "sameAs": [
        "https://en.wikipedia.org/wiki/Hersham",
        "https://www.wikidata.org/wiki/Q5744439"
      ]
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebPage",
      "@id": "https://walton-on-thames.org/hersham/#webpage",
      "url": "https://walton-on-thames.org/hersham/",
      "name": "Hersham Village, Surrey",
      "description": "A local guide to Hersham, Surrey: the green, food and drink, walks by the River Mole, history from the Domesday era to Sham 69, and village life.",
      "isPartOf": { "@id": SITE_ID },
      "about": { "@id": HERSHAM_PLACE_ID },
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": faqs.map((item) => ({
        "@type": "Question",
        "name": item.q,
        "acceptedAnswer": { "@type": "Answer", "text": item.a },
      })),
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://walton-on-thames.org/" },
        { "@type": "ListItem", "position": 2, "name": "Hersham", "item": "https://walton-on-thames.org/hersham/" }
      ]
    })} />
  </slot>

  <div class="hersham-hero">
    <div class="hersham-hero-bg" aria-hidden="true">
      <img
        src={HERSHAM_GREEN_HERO.src}
        srcset={HERSHAM_GREEN_HERO.srcset}
        sizes={HERSHAM_GREEN_HERO.sizes}
        alt={HERSHAM_GREEN_HERO.alt}
        fetchpriority="high"
        width={HERSHAM_GREEN_HERO.width}
        height={HERSHAM_GREEN_HERO.height}
      />
      <div class="hersham-hero-overlay"></div>
    </div>
    <div class="container hersham-hero-content">
      <nav aria-label="Breadcrumb">
        <ol class="breadcrumbs">
          <li><a href="/">Home</a></li>
          <li aria-current="page">Hersham</li>
        </ol>
      </nav>
      <h1>Hersham</h1>
      <p>Hersham is a village in the Borough of Elmbridge, Surrey, sitting between Walton-on-Thames to the north and Esher to the east, with the River Mole running along its edge. The 2021 census recorded 12,630 people in the Hersham built-up area, up from 11,260 in 2011. Hersham is contiguous with Walton and shares its post town, but it has kept a distinct identity: a proper village green, its own shopping parade, its own station on the main line to Waterloo, and a history that runs from medieval field-names to the punk band that put the village's name in the charts. The ironwork sign standing on the green puts it plainly: it reads Hersham Village.</p>
    </div>
  </div>

  <section class="section section-facts" aria-labelledby="hersham-facts-heading">
    <div class="container">
      <h2 id="hersham-facts-heading" class="facts-heading">Hersham at a glance</h2>
      <dl class="fact-box">
        <div><dt>County</dt><dd>Surrey</dd></div>
        <div><dt>Borough</dt><dd>Elmbridge</dd></div>
        <div><dt>Council from 2027</dt><dd>East Surrey Council, from 1 April 2027</dd></div>
        <div><dt>Borough ward</dt><dd>Hersham Village</dd></div>
        <div><dt>UK Parliament constituency</dt><dd>Esher and Walton</dd></div>
        <div><dt>Post town</dt><dd>Walton-on-Thames</dd></div>
        <div><dt>Postcode district</dt><dd>KT12</dd></div>
        <div><dt>Nearest stations</dt><dd><a href="/hersham-railway-station/">Hersham</a>, <a href="/walton-on-thames-railway-station/">Walton-on-Thames</a></dd></div>
        <div><dt>Population</dt><dd>12,630 (2021 census)</dd></div>
        <div><dt>Reference</dt><dd><a href="https://en.wikipedia.org/wiki/Hersham" rel="noopener noreferrer">Wikipedia</a>, <a href="https://www.wikidata.org/wiki/Q5744439" rel="noopener noreferrer">Wikidata</a></dd></div>
      </dl>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <article class="prose">
        <h2>The green</h2>
        <p><a href="/hersham/hersham-green/">Hersham Green</a>, around three and a half acres at the centre of the village, hosts regular events through the year and is faced by the village's shops, pub and pond. It is the natural starting point for any visit, and the closest thing Hersham has to a town square.</p>

        <h2>Food, drink and shopping</h2>
        <p>The parade by the green carries the village's everyday shops and eating, with pubs distributed through the village and towards the Mole. Full listings live in the <a href="/hersham/food-and-drink/">Hersham food and drink guide</a>, and the wider <a href="/directory/">directory</a> covers everything else, from trades to services.</p>

        <h2>Walks and green space</h2>
        <p>Within a few minutes of the built-up centre you are in fields and meadow beside the River Mole, and much of the surrounding land is Metropolitan Green Belt, wooded or farmed. Two golf courses sit within the village bounds: Burhill, whose Old Course dates to 1907, and the shorter Hersham Village course beside the Mole. Hersham is also home to one of Britain's largest recorded colonies of <a href="/hersham/parakeets/">ring-necked parakeets</a>, which mid-2000s reporting put at around 7,000 birds roosting near Esher Rugby Club. South of the village, <a href="/hersham/whiteley-village/">Whiteley Village</a> adds a third, very different kind of green space: a planned Arts and Crafts retirement community set in 225 acres of woodland.</p>

        <h2>A short history</h2>
        <p>Hersham appears in the twelfth century as Haverichesham, probably Haeferic's settlement, and only became a parish in its own right in 1851, carved out of Walton. As a girl, <a href="/hersham/queen-victoria-first-steam-train/">Queen Victoria recorded seeing her first steam train near here</a>, and George III visited Weylands Farm to see the first drill plough. In the twentieth century the village housed serious industry, from ABC Motors to Vickers-Armstrongs, and in 1975 it produced <a href="/hersham/sham-69/">Sham 69</a>, whose "Hersham Boys" reached number 6 in the charts and named the village to a generation, part of a wider cast covered in full on our <a href="/hersham/famous-residents/">famous residents</a> page. The full <a href="/hersham/history/">Hersham history section</a> covers all of it.</p>

        <h2>Getting here and around</h2>
        <p><a href="/hersham-railway-station/">Hersham station</a> sits on the South Western Main Line with two trains an hour to London Waterloo, a 33 minute journey, though it has no step-free access to either platform; <a href="/walton-on-thames-railway-station/">Walton-on-Thames station</a> also serves the west of the village. The A3 passes nearby, and the M25 is minutes away.</p>

        <h2>Explore Hersham</h2>
        <p>Everything on this site about Hersham, in one place.</p>
        <div class="explore-grid">
          {exploreGroups.map((group) => (
            <div class="explore-group">
              <h3>{group.heading}</h3>
              <ul>
                {group.links.map((link) => (
                  <li><a href={link.href}>{link.label}</a></li>
                ))}
              </ul>
            </div>
          ))}
        </div>

      </article>
    </div>
  </section>

  {hershamEvents.length > 0 && (
    <section class="section section-tinted" aria-labelledby="hersham-events-heading">
      <div class="container">
        <div class="section-header">
          <h2 id="hersham-events-heading">What's on in Hersham</h2>
          <p>The next events listed in the village. Walton and the wider area are on the main what's on page.</p>
        </div>
        <div class="card-grid">
          {hershamEvents.map((event: EventEntry) => (
            <EventCard
              title={event.data.title}
              slug={event.data.slug}
              start={event.data.start}
              venue={event.data.venue}
              category={event.data.category}
              price={event.data.price}
              image={event.data.image}
              description={event.data.description}
            />
          ))}
        </div>
        <div class="section-footer">
          <a href="/whats-on/" class="btn btn-outline">See all events</a>
        </div>
      </div>
    </section>
  )}

  <section class="section">
    <div class="container">
      <article class="prose">
        <h2>Common questions about Hersham</h2>

        {faqs.map((item) => (
          <>
            <h3>{item.q}</h3>
            <p>{item.a}</p>
            {item.followOn && (
              <p>{item.followOn.lead}<a href={item.followOn.href}>{item.followOn.label}</a>{item.followOn.tail}</p>
            )}
          </>
        ))}
      </article>
    </div>
  </section>
</BaseLayout>

<style>
  .facts-heading {
    font-size: 0.8rem;
    font-family: var(--font-body);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-slate);
    margin: 0 0 1rem;
  }

  .fact-box {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 0.85rem 2rem;
    margin: 0;
  }

  .fact-box > div {
    border-top: 1px solid var(--color-border, rgba(0, 0, 0, 0.1));
    padding-top: 0.6rem;
  }

  .fact-box dt {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-slate);
    margin: 0 0 0.15rem;
  }

  .fact-box dd {
    margin: 0;
    font-size: 0.95rem;
  }

  .explore-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.5rem 2rem;
    margin: 1.5rem 0 0;
  }

  .explore-group h3 {
    font-size: 0.8rem;
    font-family: var(--font-body);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-slate);
    margin: 0 0 0.6rem;
  }

  .explore-group ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .explore-group li {
    margin-bottom: 0.35rem;
  }

  .hersham-hero {
    position: relative;
    display: flex;
    align-items: center;
    overflow: hidden;
    color: var(--color-white);
    min-height: 380px;
  }

  .hersham-hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hersham-hero-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 55%;
  }

  .hersham-hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(1, 32, 44, 0.55) 0%,
      rgba(1, 32, 44, 0.72) 60%,
      rgba(1, 32, 44, 0.88) 100%
    );
  }

  .hersham-hero-content {
    position: relative;
    z-index: 1;
    padding: 3rem 0;
  }

  .hersham-hero-content h1 {
    font-size: clamp(2rem, 4vw, 3rem);
    color: var(--color-white);
    margin-bottom: 0.75rem;
  }

  .hersham-hero-content p {
    color: rgba(255, 255, 255, 0.85);
    font-size: 1.1rem;
    max-width: 56ch;
  }
</style>
