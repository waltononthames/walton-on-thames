---
import BaseLayout from '../../layouts/BaseLayout.astro';
import OrganisationDirectory from '../../components/OrganisationDirectory.astro';
import { getCollection } from 'astro:content';
import type { OrganisationData } from '../../utils/organisations';
import { HERSHAM_PLACE_ID, SITE_ID } from '../../utils/schema';

// The Hersham subset: organisations based in the village, plus those that
// genuinely serve it from just outside, which is why locality is an array.
const all = await getCollection(
  'organisations',
  ({ data }: { data: OrganisationData }) => data.status === 'active',
) as { data: OrganisationData }[];
const organisations: OrganisationData[] = all
  .map(entry => entry.data)
  .filter(o => o.locality.includes('hersham'));
const count = organisations.length;

const site = 'https://walton-on-thames.org';
const pageUrl = `${site}/hersham/clubs-and-societies/`;

const itemListElement = [...organisations]
  .sort((a, b) => a.name.localeCompare(b.name, 'en-GB'))
  .map((o, i) => {
    const url = o.hasPage ? `${site}/clubs/${o.slug}/` : (o.internalUrl ? site + o.internalUrl : undefined);
    return {
      "@type": "ListItem",
      "position": i + 1,
      "name": o.name,
      ...(url ? { "url": url } : {}),
    };
  });
---

<BaseLayout
  title="Clubs & Societies in Hersham | Sports, Groups & Activities"
  description="Clubs, societies and community groups in Hersham, Surrey: bowls, rugby, football, scouting, the village social club and more, each with a checked source."
>
  <slot name="structured-data">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "BreadcrumbList",
          "itemListElement": [
            { "@type": "ListItem", "position": 1, "name": "Home", "item": `${site}/` },
            { "@type": "ListItem", "position": 2, "name": "Hersham", "item": `${site}/hersham/` },
            { "@type": "ListItem", "position": 3, "name": "Clubs & Societies", "item": pageUrl }
          ]
        },
        {
          "@type": "CollectionPage",
          "@id": pageUrl,
          "url": pageUrl,
          "name": "Clubs, Societies and Community Groups in Hersham",
          "description": "Clubs, societies and community groups based in or serving Hersham, Surrey.",
          "isPartOf": { "@id": SITE_ID },
          // Reference the Hersham entity defined on /hersham/ rather than
          // describing a second, unidentified Hersham here. See src/utils/schema.ts.
          "about": { "@id": HERSHAM_PLACE_ID },
          "mainEntity": {
            "@type": "ItemList",
            "name": "Clubs, societies and community groups in Hersham",
            "numberOfItems": count,
            "itemListOrder": "https://schema.org/ItemListOrderAscending",
            "itemListElement": itemListElement
          }
        }
      ]
    })} />
  </slot>

  <div class="page-hero">
    <div class="container">
      <nav aria-label="Breadcrumb">
        <ol class="breadcrumbs">
          <li><a href="/">Home</a></li>
          <li><a href="/hersham/">Hersham</a></li>
          <li aria-current="page">Clubs & Societies</li>
        </ol>
      </nav>
      <h1>Clubs, Societies and Community Groups in Hersham</h1>
      <p>Explore {count} clubs, societies and community groups based in Hersham or serving the village.</p>
    </div>
  </div>

  <section class="section">
    <div class="container">
      <div class="org-intro">
        <p>Hersham has no parish council, so the village's organised life runs almost entirely on volunteers: a bowling club that has played at Coronation Playing Fields since 1900, a social club founded in 1921 whose main hall nights are open to anyone, a scout group with over a hundred young members in its own headquarters, and a rugby club that plays on Molesey Road despite carrying another town's name. Two of the largest are shared with Walton, which is why several organisations below appear on both this page and the wider Walton directory: they are one organisation with one page, not two listings.</p>
        <p>Every record here has been checked against the organisation's own website, its governing body or Elmbridge Borough Council. For the bodies that represent the village rather than run activities in it, including the Hersham Community Group formed in 2025, see our fuller account of <a href="/hersham/community-groups/">community groups in Hersham</a>. The <a href="/living/community/">Walton-on-Thames clubs and societies directory</a> covers the whole area.</p>
      </div>

      <OrganisationDirectory organisations={organisations} scopeLabel="Hersham clubs and groups" />

      <p class="org-accuracy-note">
        Information here is compiled from public and organisation-provided sources.
        Details change, so please check with the organisation before travelling or turning up.
      </p>

      <div class="org-cta">
        <div>
          <h2>Is your Hersham club missing?</h2>
          <p>Listing is free, and always will be. Tell us about a club we have missed, correct a detail, or ask us to remove a listing.</p>
        </div>
        <a href="/contact/" class="btn btn-primary">Get in touch</a>
      </div>

      <div class="org-onward">
        <h2>More of Hersham</h2>
        <p>Our <a href="/hersham/">Hersham guide</a> covers the village as a whole, <a href="/things-to-do/hersham/">things to do in Hersham</a> covers the green, the recreation grounds and the Mole walks, and <a href="/whats-on/">what's on</a> lists dated events including the Friday village market.</p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .org-intro {
    max-width: 70ch;
    margin-bottom: 2rem;
    color: var(--color-slate);
    line-height: 1.65;
  }

  .org-intro p + p {
    margin-top: 0.85rem;
  }

  .org-accuracy-note {
    margin-top: 2.5rem;
    padding-left: 1rem;
    border-left: 3px solid rgba(11, 36, 46, 0.12);
    font-size: 0.85rem;
    color: var(--color-slate);
    max-width: 70ch;
  }

  .org-cta {
    margin-top: 2.5rem;
    padding: 2rem;
    background: var(--color-white);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .org-cta h2 {
    font-size: 1.2rem;
    margin-bottom: 0.4rem;
  }

  .org-cta p {
    font-size: 0.95rem;
    color: var(--color-slate);
    max-width: 60ch;
  }

  .org-onward {
    margin-top: 2rem;
    max-width: 70ch;
  }

  .org-onward h2 {
    font-size: 1.2rem;
    margin-bottom: 0.4rem;
  }

  .org-onward p {
    font-size: 0.95rem;
    color: var(--color-slate);
    line-height: 1.65;
  }
</style>
