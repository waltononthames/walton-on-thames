// Every in-text author-date becomes its own link to its reference, including
// grouped ones like "(NHS, n.d.a; NHS, n.d.b)". Keys come from the reference
// text itself so the two cannot drift apart.
const citeSources = references.map((ref) => {
  const m = ref.text.match(/^(.*?) \(([^)]+)\)\s*$/);
  if (!m) throw new Error(`Reference text not in "Author (date)" form: ${ref.text}`);
  const author = m[1].includes(', ') ? m[1].split(', ')[0] : m[1];
  return { id: ref.id.replace(/^ref-/, ''), cite: [`${author}, ${m[2]}`] };
});
