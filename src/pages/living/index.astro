        <section class="guide-section" data-areas="walton-on-thames" data-primary="walton-on-thames" data-relevance="primary">
        <h2 id="at-a-glance">Walton-on-Thames at a glance</h2>
        <div class="table-wrap">
          <table class="glance-table">
            <tbody>
              {glance.map((row) => (
                <tr>
                  <th scope="row">{row.label}</th>
                  <td>
