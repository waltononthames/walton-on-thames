      </article>
    </div>
  </section>
<script is:inline>
  (function () {
    // Location-aware view. Every section, contents entry, comparison card and
    // FAQ carries data-areas, so nothing here matches on words: it reads the
    // metadata the page was built with. Without JavaScript the page shows all
    // three places, which is the honest default rather than an empty view.
    var PLACES = {
      'walton-on-thames': 'Walton-on-Thames',
      'hersham': 'Hersham',
      'whiteley-village': 'Whiteley Village',
    };
    var NEARBY = {
      'whiteley-village': ['hersham', 'walton-on-thames'],
      'hersham': ['walton-on-thames'],
      'walton-on-thames': ['hersham'],
    };

    function start() {
      var context = document.getElementById('place-context');
      var options = Array.prototype.slice.call(document.querySelectorAll('[data-place-option]'));
      if (!context || !options.length) return;

      function matches(el, place) {
        var areas = (el.getAttribute('data-areas') || '').split(/\s+/).filter(Boolean);
        return !areas.length || place === 'all' || areas.indexOf(place) !== -1;
      }

      function names(keys) {
        var list = keys.map(function (key) { return PLACES[key]; }).filter(Boolean);
        if (list.length < 2) return list.join('');
        return list.slice(0, -1).join(', ') + ' and ' + list[list.length - 1];
      }

      // "areas" is where a section appears; "primary" is what it is about.
      // A Walton section shown in the Hersham view is Nearby, not In Hersham.
      function label(el, place) {
        var areas = (el.getAttribute('data-areas') || '').split(/\s+/).filter(Boolean);
        var primary = (el.getAttribute('data-primary') || '').split(/\s+/).filter(Boolean);
        var relevance = el.getAttribute('data-relevance');
        if (place === 'all' || !areas.length) return '';
        if (relevance === 'shared') {
          return primary.length === 3 ? 'Shared across the area' : 'Shared across ' + names(primary);
        }
        if (primary.indexOf(place) !== -1) return 'In ' + PLACES[place];
        if (primary.length) return 'Nearby in ' + names(primary);
        return '';
      }

      function apply(place, announce) {
        if (!PLACES[place]) place = 'all';

        Array.prototype.forEach.call(document.querySelectorAll('.guide-section'), function (section) {
          var show = matches(section, place);
          section.hidden = !show;
          var tag = section.querySelector('.place-tag');
          var text = show ? label(section, place) : '';
          if (text && !tag) {
            tag = document.createElement('p');
            tag.className = 'place-tag';
            section.insertBefore(tag, section.firstChild);
          }
          if (tag) {
            tag.textContent = text;
            tag.hidden = !text;
          }
        });

        // Contents entries follow their sections, so the sidebar never points
        // at something that is not on the page.
        Array.prototype.forEach.call(document.querySelectorAll('[data-guide-toc] li[data-areas]'), function (item) {
          item.hidden = !matches(item, place);
        });

        Array.prototype.forEach.call(document.querySelectorAll('.comparison-card, .faq-item'), function (el) {
          el.hidden = !matches(el, place);
        });

        options.forEach(function (option) {
          var isCurrent = option.getAttribute('data-place-option') === place;
          if (isCurrent) option.setAttribute('aria-current', 'true');
          else option.removeAttribute('aria-current');
        });

        var message;
        if (place === 'all') {
          message = 'Showing all three places: Walton-on-Thames, Hersham and Whiteley Village.';
        } else {
          var nearby = (NEARBY[place] || []).map(function (key) { return PLACES[key]; });
          message = 'You are viewing information for ' + PLACES[place] + '.';
          if (nearby.length) {
            message += ' Nearby services in ' + nearby.join(' and ') + ' are included where they are relevant.';
          }
        }
        context.textContent = message;
        if (announce) {
          // Re-inserting the text makes the live region announce a change that
          // would otherwise be silent for a screen reader user.
          context.setAttribute('aria-busy', 'true');
          context.removeAttribute('aria-busy');
        }
        document.documentElement.setAttribute('data-place', place);
      }

      function fromUrl() {
        var params = new URLSearchParams(window.location.search);
        return params.get('place') || params.get('area') || 'all';
      }

      options.forEach(function (option) {
        option.addEventListener('click', function (event) {
          if (event.metaKey || event.ctrlKey || event.shiftKey || event.button !== 0) return;
          event.preventDefault();
          var place = option.getAttribute('data-place-option');
          var url = new URL(window.location.href);
          if (place === 'all') url.searchParams.delete('place');
          else url.searchParams.set('place', place);
          url.searchParams.delete('area');
          window.history.pushState({ place: place }, '', url);
          apply(place, true);
        });
      });

      window.addEventListener('popstate', function () { apply(fromUrl(), true); });
      apply(fromUrl(), false);
    }

    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', start);
    else start();
  })();
</script>

