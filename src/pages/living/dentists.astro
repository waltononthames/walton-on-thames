---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BusinessCard from '../../components/BusinessCard.astro';
import { getCollection } from 'astro:content';

const businesses = await getCollection('businesses');
const dentists = businesses
  .filter(b => b.data.subcategories.includes('dentist'))
  .sort((a, b) => a.data.neighbourhood.localeCompare(b.data.neighbourhood) || a.data.name.localeCompare(b.data.name));
---

<BaseLayout
  title="Dentists, Walton-on-Thames"
  description="Dental practices in Walton-on-Thames and Hersham, with addresses, phone numbers and NHS or private status."
>
  <slot name="structured-data">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://walton-on-thames.org/" },
        { "@type": "ListItem", "position": 2, "name": "Living", "item": "https://walton-on-thames.org/living/" },
        { "@type": "ListItem", "position": 3, "name": "Dentists", "item": "https://walton-on-thames.org/living/dentists/" }
      ]
    })} />
  </slot>

  <div class="page-hero">
    <div class="container">
      <nav aria-label="Breadcrumb">
        <ol class="breadcrumbs">
          <li><a href="/">Home</a></li>
          <li><a href="/living/">Living</a></li>
          <li aria-current="page">Dentists</li>
        </ol>
      </nav>
      <h1>Dentists</h1>
      <p>Dental practices in Walton-on-Thames and Hersham, from NHS and private mixed practices to fully private cosmetic clinics.</p>
    </div>
  </div>

  <section class="section">
    <div class="container">
      <p class="section-intro">No dental practice with a Whiteley Village address was found — the practices below are the nearest options. NHS availability changes frequently and having an NHS profile doesn't guarantee the practice is currently taking new NHS patients — confirm directly before registering.</p>
      <div class="card-grid card-grid-3">
        {dentists.map(biz => (
          <BusinessCard
            name={biz.data.name}
            slug={biz.data.slug}
            category={biz.data.category}
            neighbourhood={biz.data.neighbourhood}
            description={biz.data.description}
            images={biz.data.images}
            featured={biz.data.featured}
          />
        ))}
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="info-card">
        <h2>Related local services</h2>
        <ul class="related-links">
          <li><a href="/living/gp-surgeries/">GP Surgeries</a></li>
          <li><a href="/living/pharmacies/">Pharmacies</a></li>
          <li><a href="/living/post-offices-and-post-boxes/">Post Offices & Post Boxes</a></li>
          <li><a href="/living/council-and-services/">Council & Services</a></li>
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .section-intro {
    color: var(--color-slate);
    max-width: 70ch;
    margin-bottom: 1.5rem;
    line-height: 1.6;
  }

  .section-alt {
    background: var(--color-cream, #f7f4ee);
  }

  .info-card {
    background: var(--color-white);
    border-radius: var(--radius-lg);
    padding: 1.75rem;
    box-shadow: var(--shadow-card);
    max-width: 60ch;
  }

  .info-card h2 {
    font-size: 1.05rem;
    margin-bottom: 1rem;
  }

  .related-links {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
  }

  .related-links a {
    font-size: 0.9rem;
    color: var(--color-navy);
  }
</style>
