---
import BaseLayout from '../../layouts/BaseLayout.astro';
import OrganisationDirectory from '../../components/OrganisationDirectory.astro';
import { getCollection } from 'astro:content';
import type { OrganisationData } from '../../utils/organisations';
import { HERSHAM_PLACE_ID, SITE_ID } from '../../utils/schema';

// Only `active` records are published. `uncertain` and `closed` records exist
// so that an organisation we have looked at and could not confirm stays on
// file rather than being rediscovered from scratch next time. See
// docs/research-backlog.md for the ones that never made it this far.
const all = await getCollection(
  'organisations',
  ({ data }: { data: OrganisationData }) => data.status === 'active',
) as { data: OrganisationData }[];
const organisations: OrganisationData[] = all.map(entry => entry.data);
const count = organisations.length;


const site = 'https://walton-on-thames.org';
const pageUrl = `${site}/living/community/`;

const itemListElement = [...organisations]
  .sort((a, b) => a.name.localeCompare(b.name, 'en-GB'))
  .map((o, i) => {
    const url = o.hasPage ? `${site}/clubs/${o.slug}/` : (o.internalUrl ? site + o.internalUrl : undefined);
    return {
      "@type": "ListItem",
      "position": i + 1,
      "name": o.name,
      ...(url ? { "url": url } : {}),
    };
  });
---

<BaseLayout
  title="Clubs & Societies in Walton-on-Thames and Hersham"
  description="A directory of clubs, societies and community groups in Walton-on-Thames, Hersham and Whiteley Village, from sport and scouting to arts and support groups."
>
  <slot name="structured-data">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "BreadcrumbList",
          "itemListElement": [
            { "@type": "ListItem", "position": 1, "name": "Home", "item": `${site}/` },
            { "@type": "ListItem", "position": 2, "name": "Moving & living here", "item": `${site}/living/` },
            { "@type": "ListItem", "position": 3, "name": "Clubs & Societies", "item": pageUrl }
          ]
        },
        {
          "@type": "CollectionPage",
          "@id": pageUrl,
          "url": pageUrl,
          "name": "Clubs, Societies and Community Groups in Walton-on-Thames and Hersham",
          "description": "A directory of clubs, societies and community groups in Walton-on-Thames, Hersham and Whiteley Village.",
          "isPartOf": { "@id": SITE_ID },
          // Both places the directory covers. Hersham references the entity
          // defined on /hersham/ rather than describing a second one here.
          "about": [
            {
              "@type": "Place",
              "name": "Walton-on-Thames",
              "sameAs": "https://en.wikipedia.org/wiki/Walton-on-Thames"
            },
            { "@id": HERSHAM_PLACE_ID }
          ],
          "mainEntity": {
            "@type": "ItemList",
            "name": "Clubs, societies and community groups in Walton-on-Thames, Hersham and Whiteley Village",
            "numberOfItems": count,
            "itemListOrder": "https://schema.org/ItemListOrderAscending",
            "itemListElement": itemListElement
          }
        }
      ]
    })} />
  </slot>

  <div class="page-hero">
    <div class="container">
      <nav aria-label="Breadcrumb">
        <ol class="breadcrumbs">
          <li><a href="/">Home</a></li>
          <li><a href="/living/">Moving &amp; living here</a></li>
          <li aria-current="page">Clubs & Societies</li>
        </ol>
      </nav>
      <h1>Clubs, Societies and Community Groups in Walton-on-Thames and Hersham</h1>
      <p>Explore {count} clubs, societies and community groups across Walton-on-Thames, Hersham and Whiteley Village.</p>
    </div>
  </div>

  <section class="section">
    <div class="container">
      <div class="org-intro">
        <p>This directory covers the organised side of local life in this corner of Elmbridge: sports clubs, uniformed groups, drama and music societies, church and community groups, support charities and the bodies that speak for their villages. Every organisation listed has been checked against its own website, its governing body, or Elmbridge Borough Council, and each record carries the date we last confirmed it. Where a club is based just outside the area but genuinely serves people here, we say so on the card rather than presenting it as local.</p>
        <p>Use the two sections below to browse by who an organisation is for, or the filters to narrow by category, audience or area. Every card shows where the organisation is based, and the Area filter narrows the list to Walton-on-Thames, Hersham or Whiteley Village. Each card links either to a fuller profile on this site or to the organisation's own website. For the bodies that represent Hersham rather than run activities in it, see our account of <a href="/hersham/community-groups/">community groups in Hersham</a>.</p>
      </div>

      <OrganisationDirectory organisations={organisations} scopeLabel="clubs and groups" />

      <p class="org-accuracy-note">
        Information here is compiled from public and organisation-provided sources.
        Details change, so please check with the organisation before travelling or turning up.
      </p>

      <div class="org-cta">
        <div>
          <h2>Is your club missing, or is something wrong?</h2>
          <p>Listing is free, and always will be. Tell us about a club we have missed, correct a detail, or ask us to remove a listing.</p>
        </div>
        <a href="/contact/" class="btn btn-primary">Get in touch</a>
      </div>

      <div class="org-onward">
        <h2>Not sure what you are looking for?</h2>
        <p>If you want something to do rather than something to join, our <a href="/things-to-do/">things to do guide</a> covers days out, parks and attractions, including <a href="/things-to-do/hersham/">things to do in Hersham</a>, and <a href="/whats-on/">what's on</a> lists dated local events, rebuilt nightly.</p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .org-intro {
    max-width: 70ch;
    margin-bottom: 2rem;
    color: var(--color-slate);
    line-height: 1.65;
  }

  .org-intro p + p {
    margin-top: 0.85rem;
  }

  .org-accuracy-note {
    margin-top: 2.5rem;
    padding-left: 1rem;
    border-left: 3px solid rgba(11, 36, 46, 0.12);
    font-size: 0.85rem;
    color: var(--color-slate);
    max-width: 70ch;
  }

  .org-cta {
    margin-top: 2.5rem;
    padding: 2rem;
    background: var(--color-white);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .org-cta h2 {
    font-size: 1.2rem;
    margin-bottom: 0.4rem;
  }

  .org-cta p {
    font-size: 0.95rem;
    color: var(--color-slate);
    max-width: 60ch;
  }

  .org-onward {
    margin-top: 2rem;
    max-width: 70ch;
  }

  .org-onward h2 {
    font-size: 1.2rem;
    margin-bottom: 0.4rem;
  }

  .org-onward p {
    font-size: 0.95rem;
    color: var(--color-slate);
    line-height: 1.65;
  }
</style>
