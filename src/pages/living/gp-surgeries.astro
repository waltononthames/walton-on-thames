---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BusinessCard from '../../components/BusinessCard.astro';
import { getCollection } from 'astro:content';

const businesses = await getCollection('businesses');
const surgeries = businesses
  .filter(b => b.data.subcategories.includes('gp-surgery'))
  .sort((a, b) => a.data.neighbourhood.localeCompare(b.data.neighbourhood) || a.data.name.localeCompare(b.data.name));
---

<BaseLayout
  title="GP Surgeries — Walton-on-Thames"
  description="NHS GP surgeries in Walton-on-Thames and Hersham, with addresses, phone numbers and opening hours."
>
  <slot name="structured-data">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://walton-on-thames.org/" },
        { "@type": "ListItem", "position": 2, "name": "Living", "item": "https://walton-on-thames.org/living/" },
        { "@type": "ListItem", "position": 3, "name": "GP Surgeries", "item": "https://walton-on-thames.org/living/gp-surgeries/" }
      ]
    })} />
  </slot>

  <div class="page-hero">
    <div class="container">
      <nav aria-label="Breadcrumb">
        <ol class="breadcrumbs">
          <li><a href="/">Home</a></li>
          <li><a href="/living/">Living</a></li>
          <li aria-current="page">GP Surgeries</li>
        </ol>
      </nav>
      <h1>GP Surgeries</h1>
      <p>NHS GP surgeries in Walton-on-Thames and Hersham. Four of the six — The Red, White and Yellow Practices, plus Fort House Surgery — share the Walton Health Centre building on Rodney Road but are independent practices with their own patient lists.</p>
    </div>
  </div>

  <section class="section">
    <div class="container">
      <p class="section-intro">No GP surgery with a Whiteley Village address was found — the surgeries below are the nearest options. To register or check current availability, use <a href="https://www.nhs.uk/service-search/find-a-gp/" target="_blank" rel="noopener noreferrer">NHS's Find a GP service ↗</a>, which shows real-time acceptance status.</p>
      <p class="section-intro">Whiteley Village residents: the <a href="https://www.thewhiteleyhomestrust.org.uk/application/files/1617/7443/7330/Residents_Handbook_version_26.1.pdf" target="_blank" rel="noopener noreferrer">Whiteley Homes Trust residents' handbook ↗</a> directs residents to Hersham Surgery. Hersham Surgery has previously run occasional clinics inside Whiteley Village, but these aren't a permanent branch surgery — check current arrangements with the Trust or the surgery directly.</p>
      <div class="card-grid card-grid-3">
        {surgeries.map(biz => (
          <BusinessCard
            name={biz.data.name}
            slug={biz.data.slug}
            category={biz.data.category}
            neighbourhood={biz.data.neighbourhood}
            description={biz.data.description}
            images={biz.data.images}
            featured={biz.data.featured}
          />
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .section-intro {
    color: var(--color-slate);
    max-width: 70ch;
    margin-bottom: 1.5rem;
    line-height: 1.6;
  }
</style>
