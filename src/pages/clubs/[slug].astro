---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import {
  CATEGORY_LABELS, LOCALITY_LABELS, AUDIENCE_LABELS,
  schemaTypeFor, checkedLabel,
} from '../../utils/organisations';
import type { OrganisationData } from '../../utils/organisations';

export async function getStaticPaths() {
  // Declared inside the function: Astro extracts getStaticPaths into its own
  // module chunk, so it cannot see top-level frontmatter variables.
  // Typed against the hand-written OrganisationData shape: `getCollection`
  // resolves to `never` here, so inference would strip every property.
  type Entry = { data: OrganisationData };

  const entries = await getCollection(
    'organisations',
    ({ data }: Entry) => data.status === 'active' && data.hasPage,
  ) as Entry[];
  const all = await getCollection(
    'organisations',
    ({ data }: Entry) => data.status === 'active',
  ) as Entry[];

  return entries.map((entry: Entry) => ({
    params: { slug: entry.data.slug },
    props: {
      entry,
      related: entry.data.relatedOrganisations
        .map((slug: string) => all.find((o: Entry) => o.data.slug === slug))
        .filter((o): o is Entry => Boolean(o))
        .map((o: Entry) => ({
          name: o.data.name,
          href: o.data.hasPage ? `/clubs/${o.data.slug}/` : o.data.internalUrl,
        }))
        .filter((o: { href?: string }) => Boolean(o.href)),
    },
  }));
}

const { entry, related } = Astro.props as {
  entry: { data: OrganisationData };
  related: { name: string; href: string }[];
};
const o = entry.data;
const { Content } = await render(entry);

const site = 'https://walton-on-thames.org';
const pageUrl = `${site}/clubs/${o.slug}/`;

const inHersham = o.locality.includes('hersham');
const inWalton = o.locality.includes('walton');

// First photograph is the page hero and the Open Graph image; the rest form
// the gallery. Pages with no photographs keep the plain navy hero.
const [heroImage, ...galleryImages] = o.images;

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": `${site}/` },
        { "@type": "ListItem", "position": 2, "name": "Moving & living here", "item": `${site}/living/` },
        { "@type": "ListItem", "position": 3, "name": "Clubs & Societies", "item": `${site}/living/community/` },
        { "@type": "ListItem", "position": 4, "name": o.name, "item": pageUrl }
      ]
    },
    {
      "@type": schemaTypeFor(o.category, o.subcategory),
      "@id": pageUrl,
      "name": o.name,
      "description": o.shortDescription,
      ...(o.website ? { "url": o.website } : {}),
      ...(o.address ? { "address": o.address } : {}),
      ...(o.images.length > 0 ? { "image": o.images.map(img => new URL(img.src, site).href) } : {}),
      "areaServed": o.locality.map(l => ({ "@type": "Place", "name": LOCALITY_LABELS[l] })),
      "mainEntityOfPage": pageUrl
    }
  ]
};

// Titles run long here, so BaseLayout drops the brand suffix on most of
// them. That is the intended behaviour: the organisation's own name is
// what people search for, not ours.
const title = `${o.name} | Clubs & Societies`;
---

<BaseLayout title={title} description={o.shortDescription} image={heroImage?.src}>
  <slot name="structured-data">
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </slot>

  <div class:list={['page-hero', heroImage && 'org-hero']}>
    {heroImage && (
      <div class="org-hero-bg">
        <img
          src={heroImage.src}
          alt={heroImage.alt}
          fetchpriority="high"
          width="2048"
          height="1536"
        />
        <div class="org-hero-overlay" aria-hidden="true"></div>
      </div>
    )}
    <div class="container org-hero-content">
      <nav aria-label="Breadcrumb">
        <ol class="breadcrumbs">
          <li><a href="/">Home</a></li>
          <li><a href="/living/">Moving &amp; living here</a></li>
          <li><a href="/living/community/">Clubs & Societies</a></li>
          <li aria-current="page">{o.name}</li>
        </ol>
      </nav>
      <h1>{o.name}</h1>
      <p>{o.shortDescription}</p>
    </div>
  </div>

  <section class="section">
    <div class="container">
      <div class="org-layout">
        <div class="org-main prose">
          <Content />

          {galleryImages.length > 0 && (
            <Fragment>
              <h2>Photographs</h2>
              <div class="org-gallery">
                {galleryImages.map(img => (
                  <figure class="org-gallery-item">
                    <img src={img.src} alt={img.alt} loading="lazy" decoding="async" />
                    {img.caption && <figcaption>{img.caption}</figcaption>}
                  </figure>
                ))}
              </div>
            </Fragment>
          )}

          {/* Outside the gallery on purpose: a page with a single photograph
              has a hero but no gallery, and its credit still has to appear. */}
          {o.imageCredit && o.images.length > 0 && (
            <p class="org-image-credit">{o.imageCredit}</p>
          )}

          {/* Only when there is a website to point to. Some clubs genuinely have
              none (Ace Badminton Club, confirmed by Darren), and an invitation to
              "point us to one" would imply it exists; their contact details live
              in the record's own "Joining or taking part" section instead. */}
          {o.website && (
            <Fragment>
              <h2>Contact and official website</h2>
              <p>
                Everything current about {o.name}, including anything that has changed
                since we last checked, is on the organisation's own site.
              </p>
              <p>
                <a href={o.website} class="btn btn-primary" target="_blank" rel="noopener">
                  Visit the {o.name} website
                  <span class="sr-only"> (opens in a new tab)</span>
                </a>
              </p>
            </Fragment>
          )}

          <p class="org-checked">Information checked: {checkedLabel(o.lastVerified)}</p>
        </div>

        <aside class="org-aside" aria-labelledby="org-facts-heading">
          <h2 id="org-facts-heading" class="org-aside-heading">At a glance</h2>
          <dl class="org-facts">
            <div>
              <dt>Category</dt>
              <dd>{CATEGORY_LABELS[o.category]}{o.subcategory ? `, ${o.subcategory}` : ''}</dd>
            </div>
            <div>
              <dt>Who it is for</dt>
              <dd>{o.audience.map(a => AUDIENCE_LABELS[a]).join(', ')}</dd>
            </div>
            {o.ageRange && (
              <div>
                <dt>Ages</dt>
                <dd>{o.ageRange}</dd>
              </div>
            )}
            {o.venue && (
              <div>
                <dt>Venue</dt>
                <dd>{o.venue}</dd>
              </div>
            )}
            {o.address && (
              <div>
                <dt>Address</dt>
                <dd>{o.address}</dd>
              </div>
            )}
            {o.meetingInformation && (
              <div>
                <dt>When</dt>
                <dd>{o.meetingInformation}</dd>
              </div>
            )}
            <div>
              <dt>Area</dt>
              <dd>{o.locality.map(l => LOCALITY_LABELS[l]).join(', ')}</dd>
            </div>
          </dl>

          {related.length > 0 && (
            <div class="org-related">
              <h2 class="org-aside-heading">Related organisations</h2>
              <ul>
                {related.map(r => <li><a href={r.href}>{r.name}</a></li>)}
              </ul>
            </div>
          )}
        </aside>
      </div>

      <nav class="org-back" aria-label="More clubs and societies">
        {inWalton && <a href="/living/community/?area=walton">More clubs and societies in Walton-on-Thames</a>}
        {inHersham && <a href="/living/community/?area=hersham">More clubs and societies in Hersham</a>}
        {!inWalton && !inHersham && <a href="/living/community/">More clubs and societies</a>}
      </nav>

      <p class="org-accuracy-note">
        Information here is compiled from public and organisation-provided sources.
        Details change, so please check with the organisation before travelling or turning up.
        If something is wrong, <a href="/contact/">tell us</a> and we will correct it.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  /* Photo hero, only when the organisation supplies photographs. Mirrors the
     business listing hero, so a photographed page looks the same site-wide.
     Without photographs the shared navy .page-hero renders exactly as before. */
  .org-hero {
    position: relative;
    overflow: hidden;
    padding: 0;
    min-height: 320px;
    display: flex;
    align-items: center;
  }

  .org-hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .org-hero-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 45%;
  }

  .org-hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(1, 32, 44, 0.5) 0%, rgba(1, 32, 44, 0.66) 60%, rgba(1, 32, 44, 0.85) 100%);
  }

  .org-hero .org-hero-content {
    position: relative;
    z-index: 1;
    padding-top: 3rem;
    padding-bottom: 3rem;
  }

  /* Breadcrumbs default to slate, which is unreadable over a photograph. */
  .org-hero .breadcrumbs,
  .org-hero .breadcrumbs a,
  .org-hero .breadcrumbs li + li::before {
    color: rgba(255, 255, 255, 0.8);
  }

  .org-hero .breadcrumbs a:hover { color: var(--color-white); }

  .org-gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 1rem;
    margin: 1.5rem 0 0;
  }

  .org-gallery-item {
    margin: 0;
  }

  /* Fixed ratio keeps the grid tidy across mixed source photographs, and
     reserves space before the lazy load resolves. */
  .org-gallery-item img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
  }

  .org-gallery-item figcaption {
    margin-top: 0.5rem;
    font-size: 0.8rem;
    color: var(--color-slate);
    font-style: italic;
  }

  /* Slate rather than slate-soft: small text needs the stronger contrast. */
  .org-image-credit {
    margin-top: 1rem;
    font-size: 0.8rem;
    color: var(--color-slate);
  }

  .org-layout {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
    gap: 2.5rem;
    align-items: start;
  }

  .org-main {
    max-width: 70ch;
  }

  .org-main :global(h2) {
    font-size: 1.35rem;
  }

  .org-checked {
    margin-top: 2rem;
    font-size: 0.8rem;
    color: var(--color-slate-soft);
  }

  .org-aside {
    background: var(--color-white);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
    padding: 1.5rem;
    position: sticky;
    top: 1.5rem;
  }

  .org-aside-heading {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-slate);
    margin-bottom: 0.9rem;
  }

  .org-facts {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    font-size: 0.85rem;
    line-height: 1.5;
  }

  .org-facts dt {
    font-weight: 600;
    color: var(--color-navy);
    margin-bottom: 0.1rem;
  }

  .org-facts dd {
    color: var(--color-slate);
  }

  .org-related {
    margin-top: 1.75rem;
    padding-top: 1.25rem;
    border-top: 1px solid rgba(11, 36, 46, 0.1);
  }

  .org-related ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    font-size: 0.875rem;
  }

  .org-related a {
    color: var(--color-navy);
  }

  .org-back {
    margin-top: 2.5rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.75rem;
    font-weight: 600;
    font-size: 0.9rem;
  }

  .org-accuracy-note {
    margin-top: 1.5rem;
    padding-left: 1rem;
    border-left: 3px solid rgba(11, 36, 46, 0.12);
    font-size: 0.85rem;
    color: var(--color-slate);
    max-width: 70ch;
  }

  @media (max-width: 900px) {
    .org-layout {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .org-aside {
      position: static;
    }
  }
</style>
