  <section class="section">
    <div class="container">
      <div class="prose">
        <div class="table-wrap">
          <table>
            <tbody>
              <tr><th scope="row">Status</th><td>Adopted</td></tr>
              <tr><th scope="row">Version</th><td>0.1</td></tr>
