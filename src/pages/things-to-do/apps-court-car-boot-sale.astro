---
import { getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import EventStatusPanel from '../../components/EventStatusPanel.astro';
import statusData from '../../data/apps-court-status.json';

// The on/off status, next confirmed date, and "checked" date below come from
// src/data/apps-court-status.json, a daily scheduled check reads and rewrites
// that file (never this page) so the status stays current without a code
// change. See docs/build-log.md for how the daily check is wired up.
const {
  status: STATUS,
  headline: STATUS_HEADLINE,
  detail: STATUS_DETAIL,
  checkedDateLabel: STATUS_CHECKED_DATE,
  nextConfirmedDateISO,
  sourceLabel: STATUS_SOURCE_LABEL,
  sourceUrl: STATUS_SOURCE_URL,
} = statusData as {
  status: 'on' | 'off' | 'unconfirmed' | 'unavailable' | 'conflicting';
  headline: string;
  detail: string;
  checkedDateLabel: string;
  nextConfirmedDateISO: string | null;
  sourceLabel: string;
  sourceUrl: string;
};

// PAGE_VERIFIED_DATE covers the page's permanent editorial content (prices,
// rules, history, contact details): it only changes on a full manual
// re-check, unlike the daily-updated status data above.
const PAGE_VERIFIED_DATE = '23 July 2026';

// Only emit an Event for a specific Sunday when Apps Court Farm's own site has
// confirmed it (nextConfirmedDateISO) and the status isn't itself in doubt, 
// never generate schema for a guessed or unconfirmed future date.
const confirmedSubEvent = (nextConfirmedDateISO && (STATUS === 'on' || STATUS === 'off'))
  ? [{
      "@type": "Event",
      "name": `Apps Court Car Boot Sale: Sunday ${new Date(nextConfirmedDateISO).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}`,
      "startDate": `${nextConfirmedDateISO}T07:00:00+01:00`,
      "endDate": `${nextConfirmedDateISO}T13:00:00+01:00`,
      "eventStatus": "https://schema.org/EventScheduled",
      "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
      "url": STATUS_SOURCE_URL,
      "location": {
        "@type": "Place",
        "name": "Apps Court Farm",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "Hurst Road",
          "addressLocality": "Walton-on-Thames",
          "addressRegion": "Surrey",
          "postalCode": "KT12 2EG",
          "addressCountry": "GB"
        }
      },
      "offers": {
        "@type": "Offer",
        "price": "2",
        "priceCurrency": "GBP",
        "url": STATUS_SOURCE_URL,
        "availability": "https://schema.org/InStock",
        "validFrom": statusData.checkedDateISO
      }
    }]
  : [];

// Coordinates for the sidebar map embed come from the attraction record's
// `geo` field rather than being repeated here, so the content layer stays the
// single source of truth. The values there are the OpenStreetMap node for
// Apps Court Farm (OSM node 12431192590).
const attraction = await getEntry('attractions', 'apps-court-car-boot-sale');
if (!attraction?.data.geo) {
  throw new Error(
    'apps-court-car-boot-sale.json is missing `geo`, the map embed needs it.'
  );
}
const { lat: VENUE_LAT, lng: VENUE_LNG } = attraction.data.geo;

const pageUrl = 'https://walton-on-thames.org/things-to-do/apps-court-car-boot-sale/';

const pitchPrices = [
  { type: 'Standard car or walk-in seller', price: '£15' },
  { type: 'Small van (e.g. Citroën Berlingo SWB, Vauxhall Astra van)', price: '£15' },
  { type: 'People carrier', price: '£15' },
  { type: 'VW camper van or similar-sized camper', price: '£15' },
  { type: 'Van, VW Transporter to Mercedes Sprinter size, including flatbeds', price: '£20' },
  { type: 'Motorhome', price: '£20' },
  { type: 'Box van or Luton-size vehicle', price: 'From £30' },
  { type: 'Small trailer (must be accompanied by a full-paying vehicle)', price: '£5' },
  { type: 'Large box trailer', price: '£10' },
];

const faqs = [
  { q: 'What time does Apps Court Car Boot Sale open?', a: 'The gates open at 7am for both sellers and buyers, according to Apps Court Farm’s official car boot page.' },
  { q: 'What time does it finish?', a: 'The car boot sale is closed from 1pm. Apps Court asks sellers leaving early to drive carefully and consider buyers still on site.' },
  { q: 'Is Apps Court Car Boot Sale on this Sunday?', a: 'Check the status panel at the top of this page: it reflects what Apps Court Farm\'s own website stated when last checked. The sale runs most Sundays from early March to the autumn, plus some Bank Holiday Mondays, but is weather-dependent and can be postponed at short notice.' },
  { q: 'Do sellers need to book a pitch in advance?', a: 'No. Apps Court allocates pitches on a first-come, first-served basis. There is no advance booking system.' },
  { q: 'How much is a standard seller pitch?', a: 'A standard car or walk-in pitch costs £15. See the full pitch price table on this page for vans, trailers and motorhomes.' },
  { q: 'How much is parking for buyers?', a: 'Buyer parking costs £2 per vehicle, including motorbikes. It is collected as you leave, not on arrival.' },
  { q: 'Is there an admission charge for buyers?', a: "Apps Court Farm's published information does not mention a separate walk-in admission charge for buyers, only the £2 vehicle parking charge." },
  { q: 'Can I bring my dog?', a: 'Yes. Dogs are welcome but must be kept on a secure lead at all times, and owners must clear up after them. Dogs must not be left in cars.' },
  { q: 'Are there toilets on site?', a: 'Yes, Apps Court Farm provides free toilets, including accessible toilet facilities.' },
  { q: 'Is Apps Court Car Boot Sale wheelchair accessible?', a: 'Apps Court Farm states the farm is accessible for wheelchairs, with accessible toilets on site, but warns the ground may be uneven in places: this is outdoor farmland, not a paved car park.' },
  { q: 'Can sellers leave unsold goods or rubbish behind?', a: 'No. Apps Court operates a strict no-rubbish policy and charges a penalty for tipping. Sellers must take everything away with them.' },
  { q: 'What can I not sell at Apps Court?', a: 'Alcohol, tobacco or other products needing a licence, weapons, dangerous objects, and illegal, copied or stolen goods are all banned. Hot food and drink cannot be sold by sellers either, since the farm has its own on-site catering.' },
  { q: 'What is the postcode for Apps Court Farm?', a: 'Apps Court Farm\'s address is Hurst Road, Walton upon Thames, Surrey, KT12 2EG, per the farm\'s own contact page.' },
  { q: "What's the phone number for Apps Court car boot sale?", a: 'Apps Court Farm can be reached on 01932 244 822. A recorded message on this number confirms whether the car boot sale is taking place.' },
];
