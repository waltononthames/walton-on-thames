---
// The away fans' guide to Walton & Hersham FC. Brief: away-fans-guide-brief.md;
// plan and decisions: docs/away-fans-guide-plan.md; sources and open
// questions: docs/away-fans-guide-sources.md.
//
// All practical information comes from the away-guide collections in
// src/content/away-guide/, never from this file, so a time or a price changes
// without touching layout. Walking, driving and bus-walk times come from
// scripts/build-away-guide-map.mjs. While any fact is still a placeholder the
// page is noindex (and so outside site search), and scripts/check-away-guide.mjs
// refuses a production build on main.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Opening from '../../components/away-guide/Opening.astro';
import QuickAnswers from '../../components/away-guide/QuickAnswers.astro';
import ChapterNav from '../../components/away-guide/ChapterNav.astro';
import ChapterBreak from '../../components/away-guide/ChapterBreak.astro';
import TravelOptions from '../../components/away-guide/TravelOptions.astro';
import RouteStory from '../../components/away-guide/RouteStory.astro';
import LastTrainFinder from '../../components/away-guide/LastTrainFinder.astro';
import MatchdayTimeline from '../../components/away-guide/MatchdayTimeline.astro';
import PlacesMap, { type MapMarker } from '../../components/away-guide/PlacesMap.astro';
import VenueList, { type Venue } from '../../components/away-guide/VenueList.astro';
import PrintCard from '../../components/away-guide/PrintCard.astro';
import LiveMap from '../../components/away-guide/LiveMap.astro';
import NeedToKnow from '../../components/away-guide/NeedToKnow.astro';
import NeedToKnowRow from '../../components/away-guide/NeedToKnowRow.astro';
import Fact from '../../components/away-guide/Fact.astro';
import AttractionCard from '../../components/AttractionCard.astro';
import { attractionCardProps } from '../../utils/attractionCardProps';
import { getCollection } from 'astro:content';
import {
  awayBase, clock12, containsPlaceholder, latestChecked, longDate, shows, valueOf, GUIDE_PATH,
  PLATFORM_ALLOWANCE_MINS,
  type Fact as FactT, type GroundData, type RouteData, type TrainData, type BusData, type TaxiData, type RouteKey,
} from '../../utils/awayGuide';
import { clockFromMinutes, parseClock12, serviceMinutes, type FinderData } from '../../utils/trainTimes';

const SITE = 'https://walton-on-thames.org';
const AUTHOR = 'Darren Bayley';

// Typed here rather than inferred: the collection types the rest of the
// site relies on do not resolve under `astro check` (149 errors on main of
// this kind), and this page should add none.
type Entry<T> = { id: string; data: T };
const entries = async <T,>(name: Parameters<typeof getCollection>[0]) => (await getCollection(name)) as Entry<T>[];
const data = async <T,>(name: Parameters<typeof getCollection>[0]) => (await entries<T>(name)).map((e) => e.data);

type VenueData = Omit<Venue, 'slug' | 'badge'> & { lat: number; lng: number; area: string; featured: boolean };
type InfoData = { published?: string; history: { year: string; f: FactT<string> }[]; nickname: FactT<string>; aAndE: FactT<string>; police: FactT<string> };

const [ground] = await data<GroundData>('away-ground');
const routes = (await data<RouteData>('away-routes')).sort((a, b) => a.order - b.order);
const trains = await data<TrainData>('away-trains');
const [bus] = await data<BusData>('away-buses');
const [taxis] = await data<TaxiData>('away-taxis');
const [info] = await data<InfoData>('away-info');
const [faqData] = await data<{ items: { q: string; a: string }[] }>('away-faqs');
const venues = (await entries<VenueData>('away-venues')).map((e) => ({ ...e.data, slug: e.id }));

const everything = [ground, routes, trains, bus, taxis, info, venues];
const prototype = containsPlaceholder(everything);
const lastChecked = latestChecked(everything);
const official = valueOf(ground.officialSite) ?? 'https://waltonhershamfc.com/';

const towpathRoute = routes.find((r) => r.variant === 'towpath');
const towpathAfterDark = towpathRoute ? valueOf(towpathRoute.afterDark) : undefined;
const walkRoad = awayBase.routes.road;
const walkTow = awayBase.routes.towpath;
const driveMins = awayBase.drive.minutes;
const rideHailing = taxis.rideHailing.filter((r) => 'value' in r.note).map((r) => r.name);
const taxiLabel = ['Taxi', ...rideHailing].join(' or ');
const busWalks = awayBase.bus;
// How the two walks compare, in words. Computed here rather than in the
// template: a comparison operator inside template markup confuses the
// type-checker's parser (it reads "<" as the start of a tag).
const walkGap = walkTow.minutes - walkRoad.minutes;
const routeComparison = Math.abs(walkGap) <= 3
  ? 'The two take about the same time.'
  : walkGap > 0
    ? `The river route adds about ${walkGap} minutes.`
    : `The river route is about ${-walkGap} minutes quicker.`;

// Last Saturday and midweek departures to Waterloo, for the quick answers card.
const lastTo = (day: 'saturday' | 'weekday', direction: string) => {
  const t = trains.find((r) => r.dayType === day && r.direction === direction);
  if (!t) return null;
  const time = [...t.departures.times].sort((a, b) => serviceMinutes(a) - serviceMinutes(b)).at(-1)!;
  return { time, sample: 'placeholder' in t.departures };
};
const lastTrains = [
  { label: 'Saturday to London Waterloo', ...lastTo('saturday', 'London Waterloo') },
  { label: 'Midweek to London Waterloo', ...lastTo('weekday', 'London Waterloo') },
].filter((t): t is { label: string; time: string; sample: boolean } => Boolean(t.time));
const kickOff = {
  saturday: parseClock12(valueOf(ground.kickOffSaturday) ?? ''),
  weekday: parseClock12(valueOf(ground.kickOffMidweek) ?? ''),
};
// "Every hour at 13 minutes past, 9.13am to 6.13pm" when the minutes agree.
const hourly = (times: string[]) => {
  const mins = new Set(times.map((t) => t.slice(3)));
  const span = `${clock12(times[0])} to ${clock12(times.at(-1)!)}`;
  return mins.size === 1 ? `every hour at ${Number([...mins][0])} minutes past, ${span}` : times.map(clock12).join(', ');
};

// The finder's data, shared by the timeline and the print card.
const finderData: FinderData = {
  allowance: PLATFORM_ALLOWANCE_MINS,
  kickOff,
  walk: { road: walkRoad.minutes, towpath: walkTow.minutes },
  driveMins,
  bus: {
    fromGround: { saturday: valueOf(bus.fromGround.saturday) ?? [], weekday: valueOf(bus.fromGround.weekday) ?? [] },
    fromGroundMins: valueOf(bus.fromGroundMins) ?? null,
    groundToStop: busWalks.groundToStop.minutes,
    stopToStation: busWalks.churchStreetToStation.minutes,
  },
  trains: Object.fromEntries(['saturday', 'weekday'].map((d) => [
    d,
    trains.filter((t) => t.dayType === d).flatMap((t) => t.departures.times.map((time) => ({ time, direction: t.direction }))),
  ])),
};

// ---------------------------------------------------------------- venues

const byOrder = (a: { order: number; name: string }, b: { order: number; name: string }) => a.order - b.order || a.name.localeCompare(b.name);
const withBadges = <T extends { slug: string },>(list: T[], prefix: string) => list.map((v, i) => ({ ...v, badge: `${prefix}${i + 1}` }));
const pubs = withBadges(venues.filter((v) => v.type === 'pub' && !v.featured).sort(byOrder), 'P');
const weir = venues.find((v) => v.featured);
const grab = withBadges(venues.filter((v) => v.type === 'grab-and-go').sort(byOrder), 'F');
const sitDown = withBadges(venues.filter((v) => v.type === 'sit-down').sort(byOrder), `F`).map((v, i) => ({ ...v, badge: `F${grab.length + i + 1}` }));
const shops = withBadges(venues.filter((v) => v.type === 'supermarket').sort(byOrder), 'S');
const hotels = withBadges(venues.filter((v) => v.type === 'hotel').sort(byOrder), 'H');
const petrol = venues.filter((v) => v.type === 'petrol').sort(byOrder);

const station = awayBase.points.station;
const groundPoint = awayBase.points.ground;
const overviewMarkers: MapMarker[] = [
  { id: 'station', lat: station.lat, lng: station.lng, category: 'place', badge: 'R', name: 'Walton-on-Thames station' },
  { id: 'ground', lat: groundPoint.lat, lng: groundPoint.lng, category: 'place', badge: 'G', name: 'Elmbridge Xcel Sports Hub' },
  ...(weir ? [{ id: weir.slug, lat: weir.lat, lng: weir.lng, category: 'pub', badge: 'W', name: weir.name }] : []),
  ...pubs.map((v) => ({ id: v.slug, lat: v.lat, lng: v.lng, category: 'pub', badge: v.badge, name: v.name })),
  ...[...grab, ...sitDown].map((v) => ({ id: v.slug, lat: v.lat, lng: v.lng, category: 'food', badge: v.badge, name: v.name })),
  ...shops.map((v) => ({ id: v.slug, lat: v.lat, lng: v.lng, category: 'shop', badge: v.badge, name: v.name })),
  ...hotels.map((v) => ({ id: v.slug, lat: v.lat, lng: v.lng, category: 'hotel', badge: v.badge, name: v.name })),
  { id: 'bus-church-street', lat: busWalks.stops.churchStreet.lat, lng: busWalks.stops.churchStreet.lng, category: 'bus', badge: 'B', name: 'Church Street bus stop (564)' },
  { id: 'bus-xcel', lat: busWalks.stops.xcel.lat, lng: busWalks.stops.xcel.lng, category: 'bus', badge: 'B', name: 'Xcel Leisure Centre bus stop (564)' },
];
const siteMarkers: MapMarker[] = [
  { id: 'ground', lat: groundPoint.lat, lng: groundPoint.lng, category: 'place', badge: 'G', name: 'Elmbridge Xcel Sports Hub' },
  ...(weir ? [{ id: weir.slug, lat: weir.lat, lng: weir.lng, category: 'pub', badge: 'W', name: weir.name }] : []),
  { id: 'bus-xcel', lat: busWalks.stops.xcel.lat, lng: busWalks.stops.xcel.lng, category: 'bus', badge: 'B', name: 'Xcel Leisure Centre bus stop (564)' },
];

// ---------------------------------------------------------------- day out

const attractions = (await getCollection('attractions')) as { data: Parameters<typeof attractionCardProps>[0] & { slug: string } }[];
const DAY_OUT = ['hampton-court-palace', 'brooklands-museum', 'claremont-landscape-garden', 'walk-the-thames-path', 'walton-bridge', 'st-marys-church'];
const dayOut = DAY_OUT.map((s) => attractions.find((a) => a.data.slug === s)?.data).filter((a): a is NonNullable<typeof a> => Boolean(a));

// ---------------------------------------------------------------- FAQs

const tokens: Record<string, string | undefined> = {
  postcode: valueOf(ground.postcode),
  walkRoad: String(walkRoad.minutes),
  walkRiver: String(walkTow.minutes),
  towpathKm: (walkTow.towpathMetres / 1000).toFixed(1),
  drive: String(driveMins),
  parking: valueOf(ground.parking)?.toLowerCase(),
  accessibleParking: valueOf(ground.accessibleParking),
  prices: valueOf(ground.prices)?.replace(/^A/, 'a'),
  tickets: valueOf(ground.tickets),
  disabledSupporters: valueOf(ground.disabledSupporters),
  kickSat: valueOf(ground.kickOffSaturday),
  kickMid: valueOf(ground.kickOffMidweek),
  turnstiles: valueOf(ground.turnstilesOpen),
  busRoute: valueOf(bus.route) && `${valueOf(bus.route)} bus`,
  busFrequency: valueOf(bus.toGround.saturday) && hourly(valueOf(bus.toGround.saturday)!).replace(/^every/, 'every'),
  busLast: valueOf(bus.fromGround.saturday)?.at(-1) && clock12(valueOf(bus.fromGround.saturday)!.at(-1)!),
  lastSat: lastTrains[0] && clockFromMinutes(serviceMinutes(lastTrains[0].time)),
  lastMid: lastTrains[1] && clockFromMinutes(serviceMinutes(lastTrains[1].time)),
  timetableTo: trains[0] && longDate(trains[0].departures.timetableValidTo),
};
const faqs = faqData.items.map((item) => {
  let missing = false;
  const a = item.a.replace(/\{\{(\w+)\}\}/g, (_, k) => {
    const v = tokens[k];
    if (v == null) { missing = true; return `[${k}]`; }
    return v;
  });
  return { q: item.q, a, missing };
}).filter((f) => !f.missing || import.meta.env.DEV);

// ---------------------------------------------------------------- structured data

const fixtures = (await getCollection('fixtures')) as { data: { homeTeam: string; awayTeam: string; homeAway: string; competition: string; start: string; slug: string } }[];
const nowIso = new Date().toISOString().slice(0, 19);
const nextHome = fixtures.map((f) => f.data).filter((f) => f.homeAway === 'home' && f.start >= nowIso).sort((a, b) => a.start.localeCompare(b.start)).slice(0, 3);

const chapters = [
  { id: 'getting-here', label: 'Getting here' },
  { id: 'pubs', label: 'Pubs' },
  { id: 'the-ground', label: 'The ground' },
  { id: 'parking', label: 'Parking' },
  { id: 'food', label: 'Food' },
  { id: 'getting-home', label: 'Getting home' },
  { id: 'staying', label: 'Staying over' },
  { id: 'day-out', label: 'Day out' },
  { id: 'history', label: 'Club history' },
  { id: 'safety', label: 'Safety' },
  { id: 'faqs', label: 'FAQs' },
];
const n = (id: string) => chapters.findIndex((c) => c.id === id) + 1;

const title = "Walton & Hersham FC Away Fans' Guide | Xcel Sports Hub";
const description = 'Getting to Walton & Hersham FC from Walton-on-Thames station on foot, by bus or by taxi, with parking, pubs, food and the last trains home.';
const h1 = "The away fans' guide to Walton & Hersham FC";
const url = `${SITE}${GUIDE_PATH}`;
// Cut from the opening photograph at 1200 by 630 (plan section 10).
const ogImage = '/images/og/walton-hersham-fc-away-fans-guide.jpg';
---

<BaseLayout title={title} description={description} image={ogImage} type="article" noIndex={prototype}>
  <slot name="structured-data">
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@graph': [
        {
          '@type': 'BreadcrumbList',
          itemListElement: [
            { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE}/` },
            { '@type': 'ListItem', position: 2, name: 'Things to Do', item: `${SITE}/things-to-do/` },
            { '@type': 'ListItem', position: 3, name: "Walton & Hersham FC away fans' guide", item: url },
          ],
        },
        {
          '@type': 'Article',
          '@id': `${url}#article`,
          headline: h1,
          description,
          url,
          image: `${SITE}${ogImage}`,
          author: { '@type': 'Person', name: AUTHOR, url: `${SITE}/about/` },
          publisher: { '@id': `${SITE}/#organization` },
          about: [{ '@id': `${url}#team` }, { '@id': `${url}#stadium` }],
          ...(info.published && { datePublished: info.published }),
          ...(lastChecked && { dateModified: lastChecked }),
        },
        {
          '@type': 'StadiumOrArena',
          '@id': `${url}#stadium`,
          name: ground.name,
          address: {
            '@type': 'PostalAddress',
            streetAddress: 'Waterside Drive',
            addressLocality: 'Walton-on-Thames',
            addressRegion: 'Surrey',
            ...(valueOf(ground.postcode) && { postalCode: valueOf(ground.postcode) }),
            addressCountry: 'GB',
          },
          geo: { '@type': 'GeoCoordinates', latitude: groundPoint.lat, longitude: groundPoint.lng },
          image: `${SITE}${ogImage}`,
        },
        {
          '@type': 'SportsTeam',
          '@id': `${url}#team`,
          name: 'Walton & Hersham FC',
          sport: 'Association football',
          url: official,
          location: { '@id': `${url}#stadium` },
        },
        ...nextHome.map((f) => ({
          '@type': 'SportsEvent',
          name: `${f.homeTeam} v ${f.awayTeam}`,
          description: `${f.homeTeam} at home to ${f.awayTeam} at the ${ground.name}, Walton-on-Thames.`,
          startDate: f.start,
          image: `${SITE}${ogImage}`,
          eventStatus: 'https://schema.org/EventScheduled',
          location: { '@id': `${url}#stadium` },
          homeTeam: { '@id': `${url}#team` },
          awayTeam: { '@type': 'SportsTeam', name: f.awayTeam },
          performer: [{ '@id': `${url}#team` }, { '@type': 'SportsTeam', name: f.awayTeam }],
          organizer: { '@id': `${url}#team` },
          url: `${SITE}/whats-on/${f.slug}/`,
        })),
        ...(faqs.length ? [{
          '@type': 'FAQPage',
          mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
        }] : []),
      ],
    })} />
  </slot>

  <PrintCard
    address={valueOf(ground.address) ?? ''}
    postcode={valueOf(ground.postcode)}
    kickOffs={[
      valueOf(ground.kickOffSaturday) && `Saturday kick-off ${valueOf(ground.kickOffSaturday)}`,
      valueOf(ground.kickOffMidweek) && `Tuesday kick-off ${valueOf(ground.kickOffMidweek)}`,
      valueOf(ground.prices),
    ].filter((x): x is string => Boolean(x))}
    routes={routes.map((r) => ({
      title: `Walk ${r.title.replace(/^By/, 'by')}`,
      streets: r.streets,
      minutes: awayBase.routes[r.variant as RouteKey].minutes,
      km: (awayBase.routes[r.variant as RouteKey].metres / 1000).toFixed(1),
      pubs: pubs.filter((p) => p.routes.includes(r.variant)).map((p) => p.name),
    }))}
    finder={finderData}
    taxi={[
      `${taxiLabel}: about ${driveMins} minutes from the station.`,
      ...(valueOf(taxis.rankAtStation) ? [`${valueOf(taxis.rankAtStation)}.`] : []),
    ]}
    bus={valueOf(bus.route) && tokens.busLast ? `No bus from the station. The ${valueOf(bus.route)} runs from Church Street in the town centre, daytime only; last back from the Xcel ${tokens.busLast}.` : undefined}
    safety={[valueOf(info.aAndE), valueOf(info.police)].filter((x): x is string => Boolean(x)).map((s) => `${s}.`)}
    officialSite={official}
    checked={lastChecked && longDate(lastChecked)}
  />

  {prototype && (
    <div class="prototype-banner" role="note">
      <div class="container">
        <strong>Prototype.</strong> Anything marked <span class="banner-flag">Sample</span> is placeholder data waiting for a site visit. This page is hidden from search engines until every fact is checked.
      </div>
    </div>
  )}

  <Opening
    title={h1}
    standfirst="Everything a visiting supporter needs for a matchday at the Elmbridge Xcel Sports Hub: getting here from Walton-on-Thames station, where to eat and drink, and how to get home."
    author={AUTHOR}
    lastChecked={lastChecked}
    officialSite={official}
  />

  <QuickAnswers
    ground={ground}
    point={groundPoint}
    walkMins={walkRoad.minutes}
    driveMins={driveMins}
    busRoute={bus.route}
    lastTrains={lastTrains}
  />

  <div class="guide-body">
    <ChapterNav chapters={chapters} />

    {/* Chapter 1: Getting here */}
    <section class="chapter" id="getting-here" aria-labelledby="getting-here-title">
      <ChapterBreak id="getting-here" number={n('getting-here')} title="How to get to Walton & Hersham FC" photo="af-arrive-station" />
      <div class="container chapter-body">
        <p class="lede">
          Walton-on-Thames station is the start of every route in this guide. The Sports Hub is north of the town centre, beside the river, and the walk is a long one: about {walkRoad.minutes} minutes by road.
        </p>

        <h3 class="sub">By train</h3>
        <p class="measure">
          South Western Railway trains run to Walton-on-Thames from London Waterloo and from the Woking direction.
        </p>

        <h3 class="sub">By car</h3>
        <NeedToKnow about="by car">
          <NeedToKnowRow icon="pin" label="Sat-nav" f={ground.postcode}><Fact f={ground.postcode} /></NeedToKnowRow>
          <NeedToKnowRow icon="car" label="Parking" f={ground.parking}><Fact f={ground.parking} />. <a href="#parking">More on parking</a></NeedToKnowRow>
        </NeedToKnow>

        <h3 class="sub" id="station-to-ground">From Walton-on-Thames station to the ground</h3>
        <TravelOptions
          walks={routes.map((r) => ({
            variant: r.variant,
            title: r.title,
            metres: awayBase.routes[r.variant as RouteKey].metres,
            minutes: awayBase.routes[r.variant as RouteKey].minutes,
            bestFor: r.bestFor,
            lighting: r.lighting,
            afterDark: r.afterDark,
          }))}
          bus={bus}
          busWalks={busWalks}
          driveMins={driveMins}
          rideHailing={rideHailing}
        />

        <h3 class="sub">The walking routes</h3>
        <p class="measure">
          Both walks start at the station and follow Station Avenue, Ashley Road and the High Street into the town centre. The road route then takes Church Street, Terrace Road and Waterside Drive. The river route turns down Bridge Street, Thames Street and Manor Road to the Thames and follows the towpath for about {(walkTow.towpathMetres / 1000).toFixed(1)} km before coming up Waterside Drive. {routeComparison}
        </p>
        <RouteStory routes={routes} />

        <h3 class="sub" id="by-bus">By bus</h3>
        <NeedToKnow about="by bus">
          <NeedToKnowRow icon="bus" label="Route" f={bus.route}><Fact f={bus.route} />, run by <Fact f={bus.operator} /></NeedToKnowRow>
          <NeedToKnowRow icon="walk" label="From the station">No bus runs from Walton-on-Thames station to the ground. Walk about {busWalks.churchStreetToStation.minutes} minutes to Church Street in the town centre for the 564.</NeedToKnowRow>
          <NeedToKnowRow icon="pin" label="Get on at" f={bus.townStop}><Fact f={bus.townStop} /></NeedToKnowRow>
          <NeedToKnowRow icon="pin" label="Get off at" f={bus.groundStop}><Fact f={bus.groundStop} />, about {busWalks.groundToStop.minutes} minutes' walk from the ground</NeedToKnowRow>
          <NeedToKnowRow icon="clock" label="To the ground" f={bus.toGround.saturday}>
            <Fact f={bus.toGround.saturday}>{(v: string[]) => hourly(v).replace(/^e/, 'E')}</Fact>, taking <Fact f={bus.toGroundMins}>{(v: number) => `${v} minutes`}</Fact>
          </NeedToKnowRow>
          <NeedToKnowRow icon="clock" label="Back to town" f={bus.fromGround.saturday}>
            <Fact f={bus.fromGround.saturday}>{(v: string[]) => hourly(v).replace(/^e/, 'E')}</Fact>, taking <Fact f={bus.fromGroundMins}>{(v: number) => `${v} minutes`}</Fact>
          </NeedToKnowRow>
          <NeedToKnowRow icon="moon" label="Evenings and Sundays" f={bus.noService}><Fact f={bus.noService} /></NeedToKnowRow>
          <NeedToKnowRow icon="info" label="Timetable" f={bus.operatorUrl}>
            {valueOf(bus.operatorUrl) && <a href={valueOf(bus.operatorUrl)} rel="noopener">Falcon Buses timetable for the 564</a>}
          </NeedToKnowRow>
        </NeedToKnow>

        <h3 class="sub" id="by-taxi">By {taxiLabel.toLowerCase().replace('uber', 'Uber')}</h3>
        <p class="measure">
          The drive from the station to the Sports Hub takes about {driveMins} minutes with light traffic. After an evening match many people want a car at the same moment, so book a taxi or request an Uber before the final whistle, or be ready to wait.
        </p>
        <NeedToKnow about="by taxi">
          <NeedToKnowRow icon="car" label="Drive time">About {driveMins} minutes, {(awayBase.drive.metres / 1000).toFixed(1)} km</NeedToKnowRow>
          {taxis.rideHailing.map((r) => (
            <NeedToKnowRow icon="taxi" label={r.name} f={r.note}><Fact f={r.note} /></NeedToKnowRow>
          ))}
          <NeedToKnowRow icon="pin" label="Taxi rank" f={taxis.rankAtStation}><Fact f={taxis.rankAtStation} /></NeedToKnowRow>
          <NeedToKnowRow icon="pin" label="Where the rank is" f={taxis.rankLocation}><Fact f={taxis.rankLocation} /></NeedToKnowRow>
          <NeedToKnowRow icon="pin" label="Pickup at the ground" f={taxis.pickupAtGround}><Fact f={taxis.pickupAtGround} /></NeedToKnowRow>
          {taxis.firms.map((firm) => (
            <NeedToKnowRow icon="taxi" label={firm.name}><a href={`tel:${firm.phone.replace(/\s/g, '')}`}>{firm.phone}</a></NeedToKnowRow>
          ))}
        </NeedToKnow>

        <h3 class="sub" id="plan-your-day">Plan your matchday</h3>
        <MatchdayTimeline data={finderData} settleMins={20} pubMins={60} />
      </div>
    </section>

    {/* Chapter 2: Pubs */}
    <section class="chapter" id="pubs" aria-labelledby="pubs-title">
      <ChapterBreak id="pubs" number={n('pubs')} title="Pubs near Walton & Hersham FC" photo="af-pubs-the-weir" />
      <div class="container chapter-body">
        <p class="lede">
          The club recommends The Weir, a short walk from the ground on the towpath. Both walking routes from the station also pass pubs, listed here in walking order.
        </p>
        {weir && (
          <div class="feature" id="the-weir">
            <p class="feature-kicker">Nearest the ground</p>
            <h3>The Weir</h3>
            <p class="measure">
              Walton &amp; Hersham FC describes The Weir as "a welcoming place to have a pre-match drink or food", a short walk from the ground. It sits on the Thames towpath at the river end of Waterside Drive, beside the Sports Hub.
            </p>
            <VenueList venues={[{ ...weir, badge: 'W' }]} filters={false} />
          </div>
        )}
        <h3 class="sub">Pubs on the walking routes</h3>
        <VenueList venues={pubs} />

        <h3 class="sub" id="map">Map of pubs, food, hotels and bus stops</h3>
        <PlacesMap
          id="overview-map"
          title="Pubs, food, supermarkets, hotels and bus stops between Walton-on-Thames station and the Sports Hub"
          description={`Map showing Walton-on-Thames station at the south and the Elmbridge Xcel Sports Hub by the river to the north, with both walking routes. Marked: ${overviewMarkers.map((m) => `${m.badge}, ${m.name}`).join('; ')}.`}
          markers={overviewMarkers}
          showRoutes
          padM={200}
          aspect={1}
          categories={[
            { key: 'pub', label: 'Pubs' },
            { key: 'food', label: 'Food' },
            { key: 'shop', label: 'Supermarkets' },
            { key: 'hotel', label: 'Hotels' },
            { key: 'bus', label: 'Bus stops' },
          ]}
        >
          <LiveMap slot="after-map" markers={overviewMarkers} />
          <ol slot="list" class="map-key">
            {overviewMarkers.map((m) => <li><span class={`key-badge key-badge--${m.category}`}>{m.badge}</span> {m.name}</li>)}
          </ol>
        </PlacesMap>
      </div>
    </section>

    {/* Chapter 3: The ground */}
    <section class="chapter" id="the-ground" aria-labelledby="the-ground-title">
      <ChapterBreak id="the-ground" number={n('the-ground')} title="The ground: the Elmbridge Xcel Sports Hub" photo="af-ground-main-stand" />
      <div class="container chapter-body">
        <p class="lede">
          Walton &amp; Hersham play at the Elmbridge Xcel Sports Hub on Waterside Drive, run by Places Leisure with Elmbridge Borough Council.
        </p>
        <NeedToKnow about="the ground">
          <NeedToKnowRow icon="ticket" label="Prices" f={ground.prices}><Fact f={ground.prices} /></NeedToKnowRow>
          <NeedToKnowRow icon="ticket" label="Paying" f={ground.tickets}><Fact f={ground.tickets} />. <a href={official} rel="noopener">Club website</a></NeedToKnowRow>
          <NeedToKnowRow icon="walk" label="Disabled supporters" f={ground.disabledSupporters}><Fact f={ground.disabledSupporters} /></NeedToKnowRow>
          <NeedToKnowRow icon="clock" label="Turnstiles open" f={ground.turnstilesOpen}><Fact f={ground.turnstilesOpen} /></NeedToKnowRow>
          <NeedToKnowRow icon="shield" label="Segregation" f={ground.segregation}><Fact f={ground.segregation} /></NeedToKnowRow>
          <NeedToKnowRow icon="pin" label="The away end" f={ground.awayEnd}><Fact f={ground.awayEnd} /></NeedToKnowRow>
          <NeedToKnowRow icon="info" label="Seating" f={ground.coveredSeating}><Fact f={ground.coveredSeating} /></NeedToKnowRow>
          <NeedToKnowRow icon="info" label="Pitch" f={ground.pitch}><Fact f={ground.pitch} /></NeedToKnowRow>
          <NeedToKnowRow icon="car" label="Accessible parking" f={ground.accessibleParking}><Fact f={ground.accessibleParking} /></NeedToKnowRow>
        </NeedToKnow>
        <h3 class="sub">The Sports Hub site</h3>
        <PlacesMap
          id="site-map"
          title="The Elmbridge Xcel Sports Hub site"
          description="Map of the Sports Hub site on Waterside Drive, with the Hub outlined, its football pitches, The Weir on the towpath to the north, and the Xcel Leisure Centre bus stop."
          markers={siteMarkers}
          groundPlan
          padM={170}
          aspect={1.5}
        >
          <ol slot="list" class="map-key">
            {siteMarkers.map((m) => <li><span class={`key-badge key-badge--${m.category}`}>{m.badge}</span> {m.name}</li>)}
          </ol>
        </PlacesMap>
        <p class="measure note">The shaded outline is the Sports Hub and the green areas are its football pitches, as OpenStreetMap maps them. We will mark the main stand, the turnstiles and the away end once the club has confirmed them.</p>
      </div>
    </section>

    {/* Chapter 4: Parking */}
    <section class="chapter" id="parking" aria-labelledby="parking-title">
      <ChapterBreak id="parking" number={n('parking')} title="Parking at the Xcel Sports Hub" photo="af-parking-hub-car-park" />
      <div class="container chapter-body">
        <NeedToKnow about="parking">
          <NeedToKnowRow icon="car" label="At the Hub" f={ground.parking}><Fact f={ground.parking} /></NeedToKnowRow>
          <NeedToKnowRow icon="walk" label="Accessible bays" f={ground.accessibleParking}><Fact f={ground.accessibleParking} /></NeedToKnowRow>
          <NeedToKnowRow icon="pin" label="Sat-nav" f={ground.postcode}><Fact f={ground.postcode} /></NeedToKnowRow>
        </NeedToKnow>
        <p class="measure note">
          If the Hub car park is full, Elmbridge Borough Council's town centre car parks include <Fact f={ground.councilCarParks} />. From the town centre, follow the walking directions above. For charges, see our <a href="/getting-here/parking/">guide to parking in Walton-on-Thames</a>. Please park considerately in the streets around the Hub.
        </p>
      </div>
    </section>

    {/* Chapter 5: Food */}
    <section class="chapter" id="food" aria-labelledby="food-title">
      <ChapterBreak id="food" number={n('food')} title="Food before and after the match" photo="af-food-high-street" />
      <div class="container chapter-body">
        <p class="lede">
          Both walking routes pass through the town centre, where most of these are. Near the ground, The Weir serves food, and the pubs on the routes list their kitchen hours above.
        </p>
        <h3 class="sub">Grab and go</h3>
        <VenueList venues={grab} />
        <h3 class="sub">Sit down</h3>
        <VenueList venues={sitDown} />
        <h3 class="sub">Supermarkets on the routes</h3>
        <VenueList venues={shops} filters={false} />
        <h3 class="sub">Petrol for the drive home</h3>
        <VenueList venues={petrol} filters={false} />
      </div>
    </section>

    {/* Chapter 6: Getting home */}
    <section class="chapter" id="getting-home" aria-labelledby="getting-home-title">
      <ChapterBreak id="getting-home" number={n('getting-home')} title="Getting home: trains from Walton-on-Thames" photo="af-home-station-night" />
      <div class="container chapter-body">
        <p class="lede">
          Trains from Walton-on-Thames run to London Waterloo and towards Woking. Pick the day and how you are getting back to the station, and we will show the trains you can catch after full time.
        </p>
        <LastTrainFinder
          trains={trains}
          walk={{ road: walkRoad.minutes, towpath: walkTow.minutes }}
          towpathAfterDark={towpathAfterDark}
          driveMins={driveMins}
          kickOff={kickOff}
          bus={{
            route: valueOf(bus.route),
            fromGround: bus.fromGround,
            fromGroundMins: valueOf(bus.fromGroundMins),
            groundToStop: busWalks.groundToStop.minutes,
            stopToStation: busWalks.churchStreetToStation.minutes,
          }}
          taxiLabel={taxiLabel}
        />
        <p class="save-card"><button type="button" class="btn-save" data-print hidden>Save matchday card</button> <span class="save-hint">A one-page card with the postcode, routes, trains home and key numbers, to print or save as a PDF.</span></p>
        <ul class="links">
          <li><a href="https://www.nationalrail.co.uk/live-trains/departures/walton-on-thames/" rel="noopener">Live departures from Walton-on-Thames (National Rail)</a></li>
          <li><a href="https://www.southwesternrailway.com/" rel="noopener">South Western Railway</a>, for engineering work and disruption</li>
          <li><a href="/walton-on-thames-railway-station/">Our guide to Walton-on-Thames station</a>: platforms, step-free access and facilities</li>
        </ul>
      </div>
    </section>

    {/* Chapter 7: Staying over */}
    <section class="chapter" id="staying" aria-labelledby="staying-title">
      <ChapterBreak id="staying" number={n('staying')} title="Staying over" photo="af-staying-town-centre" />
      <div class="container chapter-body">
        <p class="lede">
          Two Travelodge hotels are in Walton itself, one opposite the station and one in the town centre on the road route. The Weir, by the ground, also has rooms.
        </p>
        <VenueList venues={[...hotels, ...(weir ? [{ ...weir, badge: 'W' }] : [])]} filters={false} level={3} />
        <p class="measure note">More hotels, B&amp;Bs and inns nearby are in our <a href="/places-to-stay/">guide to places to stay</a>.</p>
      </div>
    </section>

    {/* Chapter 8: Make a day of it */}
    <section class="chapter" id="day-out" aria-labelledby="day-out-title">
      <ChapterBreak id="day-out" number={n('day-out')} title="Make a day of it" photo="af-dayout-thames" />
      <div class="container chapter-body">
        <p class="lede">
          If you are making a weekend of it, these are within reach of Walton, from the town's own riverside to Hampton Court. More ideas are in our <a href="/things-to-do/">Things to Do guide</a>.
        </p>
        <div class="dayout-grid">
          {dayOut.map((a) => <AttractionCard {...attractionCardProps(a as any)} />)}
        </div>
      </div>
    </section>

    {/* Chapter 9: Club history */}
    <section class="chapter" id="history" aria-labelledby="history-title">
      <ChapterBreak id="history" number={n('history')} title="For groundhoppers: the Swans' story" photo="af-history-sports-hub" />
      <div class="container chapter-body">
        <p class="lede">
          Walton &amp; Hersham are known as <Fact f={info.nickname} />. The club's own history page tells the full story; here are the milestones.
        </p>
        <ol class="history">
          {info.history.filter((h) => shows(h.f)).map((h) => <li><span class="history-year">{h.year}</span> <span><Fact f={h.f} />.</span></li>)}
        </ol>
        <p class="measure note">The club's history page: <a href="https://waltonhershamfc.com/club/history/" rel="noopener">waltonhershamfc.com/club/history</a>. Our <a href="/history/">local history section</a> covers the town the club grew up in.</p>
      </div>
    </section>

    {/* Chapter 10: Safety */}
    <section class="chapter" id="safety" aria-labelledby="safety-title">
      <ChapterBreak id="safety" number={n('safety')} title="Practical and safety" photo="af-safety-station" />
      <div class="container chapter-body">
        <NeedToKnow about="safety">
          <NeedToKnowRow icon="shield" label="Emergency and police" f={info.police}><Fact f={info.police} /></NeedToKnowRow>
          <NeedToKnowRow icon="info" label="Nearest A&E" f={info.aAndE}><Fact f={info.aAndE} /></NeedToKnowRow>
          <NeedToKnowRow icon="info" label="Pharmacies"><a href="/living/pharmacies/">Pharmacies in Walton-on-Thames and Hersham</a></NeedToKnowRow>
        </NeedToKnow>
      </div>
    </section>

    {/* Chapter 11: FAQs */}
    <section class="chapter" id="faqs" aria-labelledby="faqs-title">
      <ChapterBreak id="faqs" number={n('faqs')} title="Frequently asked questions" photo="af-faqs-floodlights" />
      <div class="container chapter-body">
        <div class="faqs">
          {faqs.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <p>{f.missing ? <span class="fact fact--unconfirmed">Unconfirmed: {f.a}</span> : f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <footer class="guide-foot container">
      <div class="guide-foot-card">
        <p>
          <strong>About this guide.</strong> Written by {AUTHOR}{lastChecked && <>, last checked {longDate(lastChecked)}</>}. Walking and driving times are typical estimates from OpenStreetMap routing. Every other practical fact is checked against the club, the operator or the venue, and dated.
        </p>
        <p>
          Something changed? <a href="/contact/?subject=away-guide">Report a change to this guide</a>.
        </p>
        <p>
          We are an independent community website with no connection to Walton &amp; Hersham FC. For tickets and matchday announcements, see the <a href={official} rel="noopener">club's official website</a>.
        </p>
      </div>
    </footer>
  </div>
</BaseLayout>

