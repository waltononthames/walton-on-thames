---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { formatPlaceName } from '../../utils/format';

// Without this, Astro.props infers as `never` and every biz.data.* reference
// below reports ts(2339). Typing the props clears all of them.
type Props = { biz: CollectionEntry<'businesses'> };

type ListingImage = { src: string; alt: string; caption?: string };

export async function getStaticPaths() {
  const businesses = await getCollection('businesses');
  return businesses.map(biz => ({
    params: { slug: biz.data.slug },
    props: { biz },
  }));
}

const { biz } = Astro.props;
const { Content } = await render(biz);

// First image is the hero, the rest form the gallery. Listings with no
// images keep the plain navy .page-hero and render no gallery at all.
const [heroImage, ...galleryImages] = biz.data.images;


const categoryLabel = biz.data.category.replace(/-/g, ' ').replace(/\b\w/g, (c: string) => c.toUpperCase());
const neighbourhoodLabel = formatPlaceName(biz.data.neighbourhood);

const SCHEMA_TYPE_BY_CATEGORY: Record<string, string> = {
  'restaurants': 'Restaurant',
  'takeaways': 'FastFoodRestaurant',
  'cafes': 'CafeOrCoffeeShop',
  'pubs-and-bars': 'BarOrPub',
  'accommodation': 'LodgingBusiness',
  'health-and-fitness': 'SportsActivityLocation',
  'shopping': 'Store',
};
const schemaType = SCHEMA_TYPE_BY_CATEGORY[biz.data.category] ?? 'LocalBusiness';

const dayNames: Record<string, string> = { mon: 'Monday', tue: 'Tuesday', wed: 'Wednesday', thu: 'Thursday', fri: 'Friday', sat: 'Saturday', sun: 'Sunday' };
const days = ['mon','tue','wed','thu','fri','sat','sun'];
const schemaDayName: Record<string, string> = { mon: 'Monday', tue: 'Tuesday', wed: 'Wednesday', thu: 'Thursday', fri: 'Friday', sat: 'Saturday', sun: 'Sunday' };

// Parses "9am–5:30pm" / "8:30am–6:30pm" style strings into 24-hour opens/closes.
// Returns null for "Closed" or anything that doesn't match the expected pattern
// (rather than guessing) so malformed hours are silently omitted from schema.
function parseTimeRange(range: string): { opens: string; closes: string } | null {
  const m = range.match(/^(\d{1,2})(?::(\d{2}))?(am|pm)\s*[–-]\s*(\d{1,2})(?::(\d{2}))?(am|pm)$/i);
  if (!m) return null;
  const to24 = (h: string, min: string | undefined, ap: string) => {
    let hour = parseInt(h, 10) % 12;
    if (ap.toLowerCase() === 'pm') hour += 12;
    return `${String(hour).padStart(2, '0')}:${min ?? '00'}`;
  };
  return {
    opens: to24(m[1], m[2], m[3]),
    closes: to24(m[4], m[5], m[6]),
  };
}

const openingHoursSpecification = biz.data.hours
  ? days
      .map((d) => {
        const raw = biz.data.hours?.[d];
        if (!raw) return null;
        const parsed = parseTimeRange(raw);
        if (!parsed) return null;
        return {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": `https://schema.org/${schemaDayName[d]}`,
          "opens": parsed.opens,
          "closes": parsed.closes,
        };
      })
      .filter((x) => x !== null)
  : [];
---

<BaseLayout
  title={`${biz.data.name}: ${categoryLabel} in ${neighbourhoodLabel}`}
  description={biz.data.description}
  image={heroImage?.src}
>
  <slot name="structured-data">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": schemaType,
      "name": biz.data.name,
      "description": biz.data.description,
      ...(biz.data.website ? { "url": biz.data.website } : {}),
      "address": {
        "@type": "PostalAddress",
        "streetAddress": biz.data.address,
        "addressLocality": neighbourhoodLabel,
        "addressRegion": "Surrey",
        "addressCountry": "GB"
      },
      ...(biz.data.phone ? { "telephone": biz.data.phone } : {}),
      ...(biz.data.images.length > 0
        ? { "image": biz.data.images.map((img: ListingImage) => new URL(img.src, Astro.site).href) }
        : {}),
      ...(biz.data.lat && biz.data.lng ? {
        "geo": { "@type": "GeoCoordinates", "latitude": biz.data.lat, "longitude": biz.data.lng }
      } : {}),
      ...(openingHoursSpecification.length > 0 ? { "openingHoursSpecification": openingHoursSpecification } : {}),
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://walton-on-thames.org/" },
        { "@type": "ListItem", "position": 2, "name": "Directory", "item": "https://walton-on-thames.org/directory/" },
        { "@type": "ListItem", "position": 3, "name": biz.data.name, "item": `https://walton-on-thames.org/directory/${biz.data.slug}/` }
      ]
    })} />
  </slot>

  <div class:list={['page-hero', heroImage && 'biz-hero']}>
    {heroImage && (
      <div class="biz-hero-bg" aria-hidden="true">
        <img
          src={heroImage.src}
          alt={heroImage.alt}
          fetchpriority="high"
          width="2048"
          height="1152"
        />
        <div class="biz-hero-overlay"></div>
      </div>
    )}
    <div class="container biz-hero-content">
      <nav aria-label="Breadcrumb">
        <ol class="breadcrumbs">
          <li><a href="/">Home</a></li>
          <li><a href="/directory/">Directory</a></li>
          <li aria-current="page">{biz.data.name}</li>
        </ol>
      </nav>
      <div class="hero-meta">
        <span class="badge badge-accent">{categoryLabel}</span>
        <span class="badge">{neighbourhoodLabel}</span>
        {biz.data.featured && <span class="badge badge-accent">Local highlight</span>}
      </div>
      <h1>{biz.data.name}</h1>
      <p>{biz.data.description}</p>
    </div>
  </div>

  <section class="section">
    <div class="container content-layout">
      <article class="prose">
        <Content />

        {galleryImages.length > 0 && (
          <>
            <h2>Photographs</h2>
            <div class="biz-gallery">
              {galleryImages.map((img: ListingImage) => (
                <figure class="biz-gallery-item">
                  <img src={img.src} alt={img.alt} loading="lazy" />
                  {img.caption && <figcaption>{img.caption}</figcaption>}
                </figure>
              ))}
            </div>
            {biz.data.image_credit && (
              <p class="biz-image-credit">{biz.data.image_credit}</p>
            )}
          </>
        )}
      </article>

      <aside class="biz-sidebar">
        <!-- Address -->
        <div class="info-card">
          <h2>Address</h2>
          <address class="biz-address">{biz.data.address}</address>
          {biz.data.phone && (
            <a href={`tel:${biz.data.phone}`} class="contact-link">📞 {biz.data.phone}</a>
          )}
          {biz.data.website && (
            <a href={biz.data.website} target="_blank" rel="noopener noreferrer" class="contact-link">
              🌐 Visit website ↗
            </a>
          )}
        </div>

        <!-- Opening hours -->
        {biz.data.hours && (
          <div class="info-card">
            <h2>Opening Hours</h2>
            <table class="hours-table">
              {days.filter(d => biz.data.hours?.[d]).map(day => (
                <tr>
                  <th>{dayNames[day]}</th>
                  <td>{biz.data.hours?.[day]}</td>
                </tr>
              ))}
            </table>
          </div>
        )}

        <!-- Map -->
        {biz.data.lat && biz.data.lng && (
          <div class="info-card">
            <h2>Map</h2>
            <iframe
              title={`Map showing ${biz.data.name}`}
              src={`https://www.openstreetmap.org/export/embed.html?bbox=${biz.data.lng - 0.008},${biz.data.lat - 0.005},${biz.data.lng + 0.008},${biz.data.lat + 0.005}&layer=mapnik&marker=${biz.data.lat},${biz.data.lng}`}
              loading="lazy"
              width="100%"
              height="220"
              style="border: none; border-radius: 8px;"
            ></iframe>
          </div>
        )}

        <!-- Suggest an edit -->
        <div class="info-card suggest-edit">
          <h2>Suggest an edit</h2>
          <p>Is this listing out of date? Own this business?</p>
          <a href={`/contact/?subject=Listing+edit:+${encodeURIComponent(biz.data.name)}`} class="btn btn-outline" style="width:100%; justify-content:center; margin-top: 0.5rem;">
            Suggest an edit
          </a>
          {biz.data.verified_date && (
            <p class="verified-note">Last verified: {biz.data.verified_date}</p>
          )}
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  /* Photo hero, used only when the listing supplies images. Without them the
     shared .page-hero navy band renders exactly as before. */
  .biz-hero {
    position: relative;
    overflow: hidden;
    padding: 0;
    min-height: 320px;
    display: flex;
    align-items: center;
  }

  .biz-hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .biz-hero-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 55%;
  }

  .biz-hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(1, 32, 44, 0.5) 0%, rgba(1, 32, 44, 0.66) 60%, rgba(1, 32, 44, 0.85) 100%);
  }

  .biz-hero .biz-hero-content {
    position: relative;
    z-index: 1;
    padding-top: 3rem;
    padding-bottom: 3rem;
  }

  /* Breadcrumbs default to slate, which is unreadable over a photograph. */
  .biz-hero .breadcrumbs,
  .biz-hero .breadcrumbs a,
  .biz-hero .breadcrumbs li + li::before {
    color: rgba(255, 255, 255, 0.8);
  }

  .biz-hero .breadcrumbs a:hover { color: var(--color-white); }

  .biz-gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 1rem;
    margin: 1.5rem 0 0;
  }

  .biz-gallery-item {
    margin: 0;
  }

  /* Fixed ratio keeps the grid tidy across mixed portrait and landscape
     source photographs, and reserves space before the lazy load resolves. */
  .biz-gallery-item img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
  }

  .biz-gallery-item figcaption {
    margin-top: 0.5rem;
    font-size: 0.8rem;
    color: var(--color-slate);
    font-style: italic;
  }

  .biz-image-credit {
    margin-top: 1rem;
    font-size: 0.8rem;
    color: var(--color-slate-soft);
  }

  .hero-meta {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
    flex-wrap: wrap;
  }

  .content-layout {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: 3rem;
    align-items: start;
  }

  .info-card {
    background: var(--color-white);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
    box-shadow: var(--shadow-card);
    margin-bottom: 1.25rem;
  }

  .info-card h2 {
    font-size: 0.75rem;
    font-family: var(--font-body);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-slate);
    margin-bottom: 0.875rem;
  }

  .biz-address {
    font-style: normal;
    font-size: 0.9rem;
    color: var(--color-navy);
    line-height: 1.6;
    margin-bottom: 0.75rem;
  }

  .contact-link {
    display: block;
    font-size: 0.875rem;
    color: var(--color-navy);
    text-decoration: none;
    padding: 0.4rem 0;
    transition: color 0.15s;
  }

  .contact-link:hover { color: var(--color-accent); }

  .hours-table { width: 100%; border-collapse: collapse; }
  .hours-table tr + tr { border-top: 1px solid rgba(11,36,46,0.06); }
  .hours-table th, .hours-table td {
    padding: 0.4rem 0;
    font-size: 0.875rem;
    text-align: left;
  }
  .hours-table th { color: var(--color-slate); font-weight: 500; width: 50%; }
  .hours-table td { color: var(--color-navy); }

  .verified-note {
    font-size: 0.75rem;
    color: var(--color-slate-soft);
    margin-top: 0.75rem;
    text-align: center;
  }

  @media (max-width: 900px) {
    .content-layout { grid-template-columns: 1fr; }
  }
</style>
