  { id: 'bean-on-the-green', name: 'Bean on the Green', area: 'Hersham', why: 'Our preferred independent option in Hersham' },
  { id: 'costa-hersham', name: 'Costa Coffee', area: 'Hersham', why: 'A dependable Hersham alternative' },
  { id: 'whiteley-community-cafe', name: 'The Whiteley Community Café', area: 'Whiteley Village', why: 'Free Wi-Fi, plenty of power points and suited to informal meetings' },
