const sources = [
  { label: 'Food Standards Agency, food hygiene rating register: addresses for every venue in this guide', url: 'https://ratings.food.gov.uk/' },
  { label: 'Cacao Route: contact page', url: 'https://cacaoroute.co.uk/contact.html' },
  { label: 'Cacao Route: menu', url: 'https://cacaoroute.co.uk/menu.html' },
  { label: 'Cacao Route: about', url: 'https://cacaoroute.co.uk/about.html' },
  { label: 'Starbucks: Walton on Thames, Sainsbury’s store page', url: 'https://www.starbucks.co.uk/store-locator/12312' },
  { label: 'Greggs: Walton on Thames, The Heart shop page', url: 'https://www.greggs.com/shops/walton-on-thames/u45-the-heart/6446' },
  { label: 'Esquires Coffee: Walton-on-Thames store page', url: 'https://esquirescoffee.co.uk/store/esquires-walton-on-thames/' },
  { label: 'Riverhouse Barn: Community Café', url: 'https://riverhousebarn.co.uk/cafe/' },
  { label: 'The Walton Village: website', url: 'https://thewaltonvillage.com/' },
  { label: 'Whiteley Homes Trust: Community Café', url: 'https://www.thewhiteleyhomestrust.org.uk/community-and-activities/community-cafe' },
