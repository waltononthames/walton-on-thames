---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const events = await getCollection('events');
  const fixtures = await getCollection('fixtures');
  const today = new Date();
  today.setHours(0, 0, 0, 0);

  const isUpcoming = (start: string, end?: string) => {
    const d = new Date(end ?? start);
    d.setHours(0, 0, 0, 0);
    return d >= today;
  };

  const eventPaths = events
    .filter((e: (typeof events)[number]) => isUpcoming(e.data.start, e.data.end))
    .map((event: (typeof events)[number]) => ({
      params: { slug: event.data.slug },
      props: { kind: 'event' as const, event },
    }));

  const fixturePaths = fixtures
    .filter((f: (typeof fixtures)[number]) => isUpcoming(f.data.start, f.data.end))
    .map((fixture: (typeof fixtures)[number]) => ({
      params: { slug: fixture.data.slug },
      props: { kind: 'fixture' as const, fixture },
    }));

  return [...eventPaths, ...fixturePaths];
}

const { kind } = Astro.props;

const title = kind === 'event' ? Astro.props.event.data.title : `${Astro.props.fixture.data.homeTeam} vs ${Astro.props.fixture.data.awayTeam}`;
const slug = kind === 'event' ? Astro.props.event.data.slug : Astro.props.fixture.data.slug;
const startRaw = kind === 'event' ? Astro.props.event.data.start : Astro.props.fixture.data.start;
const endRaw = kind === 'event' ? Astro.props.event.data.end : Astro.props.fixture.data.end;
const venue = kind === 'event' ? Astro.props.event.data.venue : Astro.props.fixture.data.venue;
const price = kind === 'event' ? Astro.props.event.data.price : 'See club for ticket prices';
const categoryLabel = kind === 'event'
  ? Astro.props.event.data.category.replace(/-/g, ' ').replace(/\b\w/g, (c: string) => c.toUpperCase())
  : 'Sport';
const image = kind === 'event' ? Astro.props.event.data.image : undefined;
const description = kind === 'event'
  ? Astro.props.event.data.description
  : `${Astro.props.fixture.data.competition} fixture: Walton & Hersham ${Astro.props.fixture.data.homeAway === 'home' ? 'at home' : 'away'} to ${Astro.props.fixture.data.homeAway === 'home' ? Astro.props.fixture.data.awayTeam : Astro.props.fixture.data.homeTeam}.`;

const isAwayFixture = kind === 'fixture' && Astro.props.fixture.data.homeAway === 'away';

const { Content } = kind === 'event' ? await render(Astro.props.event) : { Content: undefined };

const start = new Date(startRaw);
const end = endRaw ? new Date(endRaw) : null;
const dateStr = start.toLocaleDateString('en-GB', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
// The tag gets a compact date so the event's own name keeps the characters
// Google will actually show; the page keeps the long form above.
const titleDateStr = start.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
const timeStr = start.toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit' });
const endTimeStr = end ? end.toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit' }) : null;
const isFreeEvent = /^free/i.test(price);
---

<BaseLayout
  title={`${title}: ${titleDateStr}`}
  description={description ?? `${title} — ${venue}`}
  image={image}
>
  <slot name="structured-data">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Event",
      "name": title,
      "startDate": startRaw,
      ...(endRaw ? { "endDate": endRaw } : {}),
      "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
      "eventStatus": "https://schema.org/EventScheduled",
      "location": {
        "@type": "Place",
        "name": venue,
        "address": isAwayFixture
          ? venue
          : { "@type": "PostalAddress", "addressLocality": "Walton-on-Thames", "addressRegion": "Surrey", "addressCountry": "GB" }
      },
      ...(isFreeEvent ? {
        "offers": {
          "@type": "Offer",
          "price": "0",
          "priceCurrency": "GBP",
          "availability": "https://schema.org/InStock",
          "url": `https://walton-on-thames.org/whats-on/${slug}/`
        }
      } : {}),
      ...(kind === 'fixture' ? {
        "performer": [
          { "@type": "SportsTeam", "name": Astro.props.fixture.data.homeTeam },
          { "@type": "SportsTeam", "name": Astro.props.fixture.data.awayTeam }
        ],
        "organizer": { "@type": "SportsOrganization", "name": "Walton & Hersham Football Club" }
      } : {
        "organizer": { "@type": "Organization", "name": "Walton-on-Thames.org", "url": "https://walton-on-thames.org/" }
      }),
      ...(image ? { "image": `https://walton-on-thames.org${image}` } : {}),
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://walton-on-thames.org/" },
        { "@type": "ListItem", "position": 2, "name": "What's On", "item": "https://walton-on-thames.org/whats-on/" },
        { "@type": "ListItem", "position": 3, "name": title, "item": `https://walton-on-thames.org/whats-on/${slug}/` }
      ]
    })} />
  </slot>

  <div class="page-hero">
    <div class="container">
      <nav aria-label="Breadcrumb">
        <ol class="breadcrumbs">
          <li><a href="/">Home</a></li>
          <li><a href="/whats-on/">What's On</a></li>
          <li aria-current="page">{title}</li>
        </ol>
      </nav>
      <div class="hero-meta">
        <span class="badge badge-accent">{categoryLabel}</span>
        <span class="badge">{price}</span>
      </div>
      <h1>{title}</h1>
      <div class="event-datetime">
        <time datetime={startRaw}>{dateStr} · {timeStr}{endTimeStr ? ` – ${endTimeStr}` : ''}</time>
      </div>
      <p class="event-venue">📍 {venue}</p>
    </div>
  </div>

  <section class="section">
    <div class="container content-layout">
      <article class="prose">
        {kind === 'event' && Content ? <Content /> : <p>{description}</p>}
        {kind === 'event' && Astro.props.event.data.source_url && (
          <p><a href={Astro.props.event.data.source_url} target="_blank" rel="noopener noreferrer">More information on the official event page ↗</a></p>
        )}
        {kind === 'fixture' && (
          <p><a href="https://waltonhershamfc.com/fixtures/first-team/" target="_blank" rel="noopener noreferrer">Full fixture list on the official Walton & Hersham FC site ↗</a></p>
        )}
      </article>

      <aside>
        <div class="info-card">
          <h2>Event details</h2>
          <dl class="event-details">
            <dt>Date</dt>
            <dd><time datetime={startRaw}>{dateStr}</time></dd>
            <dt>Time</dt>
            <dd>{timeStr}{endTimeStr ? ` – ${endTimeStr}` : ''}</dd>
            <dt>Venue</dt>
            <dd>{venue}</dd>
            <dt>Price</dt>
            <dd>{price}</dd>
            {kind === 'event' && Astro.props.event.data.recurring && (
              <>
                <dt>Recurring</dt>
                <dd>Yes — check for latest dates</dd>
              </>
            )}
          </dl>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .hero-meta {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
    flex-wrap: wrap;
  }

  .event-datetime {
    font-size: 1.1rem;
    font-weight: 600;
    color: rgba(255,255,255,0.9);
    margin-bottom: 0.5rem;
  }

  .event-venue {
    color: rgba(255,255,255,0.7);
    font-size: 0.95rem;
  }

  .content-layout {
    display: grid;
    grid-template-columns: 1fr 300px;
    gap: 3rem;
    align-items: start;
  }

  .info-card {
    background: var(--color-white);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
    box-shadow: var(--shadow-card);
  }

  .info-card h2 {
    font-size: 0.75rem;
    font-family: var(--font-body);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-slate);
    margin-bottom: 1rem;
  }

  .event-details {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.5rem 1rem;
    font-size: 0.875rem;
  }

  .event-details dt {
    color: var(--color-slate);
    font-weight: 500;
  }

  .event-details dd {
    color: var(--color-navy);
  }

  @media (max-width: 900px) {
    .content-layout { grid-template-columns: 1fr; }
  }
</style>
