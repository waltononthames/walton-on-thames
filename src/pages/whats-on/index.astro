---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EventCard from '../../components/EventCard.astro';
import { getCollection } from 'astro:content';

interface UpcomingItem {
  title: string;
  slug: string;
  start: string;
  end?: string;
  venue: string;
  category: string;
  price: string;
  image?: string;
  description?: string;
}

const events = await getCollection('events');
const fixtures = await getCollection('fixtures');

const eventItems: UpcomingItem[] = events.map(e => ({
  title: e.data.title,
  slug: e.data.slug,
  start: e.data.start,
  end: e.data.end,
  venue: e.data.venue,
  category: e.data.category,
  price: e.data.price,
  image: e.data.image,
  description: e.data.description,
}));

const fixtureItems: UpcomingItem[] = fixtures.map(f => ({
  title: `${f.data.homeTeam} vs ${f.data.awayTeam}`,
  slug: f.data.slug,
  start: f.data.start,
  end: f.data.end,
  venue: f.data.venue,
  category: 'sport',
  price: 'See club for ticket prices',
  description: `${f.data.competition} fixture${f.data.matchWeek ? ` (match week ${f.data.matchWeek})` : ''} — Walton & Hersham ${f.data.homeAway === 'home' ? 'at home' : 'away'}.`,
}));

// Filter to items whose end date (or start date if no end) is today or in the future.
// "Today" is midnight at build time — Cloudflare Pages rebuilds nightly so past events
// (and played fixtures) drop off the site the morning after they finish.
const today = new Date();
today.setHours(0, 0, 0, 0);

function itemEndDay(item: UpcomingItem): Date {
  const d = new Date(item.end ?? item.start);
  d.setHours(0, 0, 0, 0);
  return d;
}

const upcoming = [...eventItems, ...fixtureItems]
  .filter(item => itemEndDay(item) >= today)
  .sort((a, b) => new Date(a.start).getTime() - new Date(b.start).getTime());

function eventSchema(item: UpcomingItem) {
  const isFreeEvent = /^free/i.test(item.price);
  return {
    "@type": "Event",
    "name": item.title,
    "url": `https://walton-on-thames.org/whats-on/${item.slug}/`,
    "startDate": item.start,
    ...(item.end ? { "endDate": item.end } : {}),
    "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
    "eventStatus": "https://schema.org/EventScheduled",
    "location": {
      "@type": "Place",
      "name": item.venue,
      "address": { "@type": "PostalAddress", "addressLocality": "Walton-on-Thames", "addressRegion": "Surrey", "addressCountry": "GB" }
    },
    ...(isFreeEvent ? {
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "GBP",
        "availability": "https://schema.org/InStock",
        "url": `https://walton-on-thames.org/whats-on/${item.slug}/`
      }
    } : {}),
    ...(item.image ? { "image": `https://walton-on-thames.org${item.image}` } : {}),
  };
}
---

<BaseLayout
  title="What's On in Walton-on-Thames | Events & Festivals"
  description="Events and things to do in Walton-on-Thames, Hersham and Whiteley Village — festivals, markets, community events, sport and more."
>
  <slot name="structured-data">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://walton-on-thames.org/" },
        { "@type": "ListItem", "position": 2, "name": "What's On", "item": "https://walton-on-thames.org/whats-on/" }
      ]
    })} />
    {upcoming.length > 0 && (
      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "ItemList",
        "itemListElement": upcoming.map((event, i) => ({
          "@type": "ListItem",
          "position": i + 1,
          "item": eventSchema(event)
        }))
      })} />
    )}
  </slot>

  <div class="page-hero">
    <div class="container">
      <nav aria-label="Breadcrumb">
        <ol class="breadcrumbs">
          <li><a href="/">Home</a></li>
          <li aria-current="page">What's On</li>
        </ol>
      </nav>
      <h1>What's On</h1>
      <p>Events, festivals, markets and community activities across Walton-on-Thames, Hersham and Whiteley Village.</p>
    </div>
  </div>

  <section class="section">
    <div class="container">
      {upcoming.length > 0 ? (
        <>
          <div class="section-header">
            <h2>Upcoming Events</h2>
          </div>
          <div class="card-grid card-grid-3">
            {upcoming.map(item => (
              <EventCard
                title={item.title}
                slug={item.slug}
                start={item.start}
                venue={item.venue}
                category={item.category}
                price={item.price}
                image={item.image}
                description={item.description}
              />
            ))}
          </div>
        </>
      ) : (
        <p class="empty-state">No upcoming events right now — check back soon or <a href="/community/news/">read the local news</a>.</p>
      )}

      <div class="submit-event">
        <p>Know of an event that should be listed here?</p>
        <a href="/contact/?subject=Event+submission" class="btn btn-primary">Submit an event</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .empty-state {
    color: var(--color-slate);
    font-size: 1.05rem;
    padding: 2rem 0;
  }

  .submit-event {
    margin-top: 3rem;
    padding: 2rem;
    background: var(--color-white);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .submit-event p { color: var(--color-slate); }
</style>
