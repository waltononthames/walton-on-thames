---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EventRow from '../../components/EventRow.astro';
import { getCollection } from 'astro:content';
import { isMultiDay } from '../../utils/eventDates';

interface UpcomingItem {
  title: string;
  slug: string;
  start: string;
  end?: string;
  venue: string;
  category: string;
  price: string;
  image?: string;
  description?: string;
  recurring?: boolean;
  isFixture?: boolean;
  /** Away fixtures are not in Walton: their venue string (which includes the town) is used as the address instead of the local PostalAddress */
  isAwayFixture?: boolean;
}

const events = await getCollection('events');
const fixtures = await getCollection('fixtures');

const eventItems: UpcomingItem[] = events.map(e => ({
  title: e.data.title,
  slug: e.data.slug,
  start: e.data.start,
  end: e.data.end,
  venue: e.data.venue,
  category: e.data.category,
  price: e.data.price,
  image: e.data.image,
  description: e.data.description,
  recurring: e.data.recurring,
}));

const fixtureItems: UpcomingItem[] = fixtures.map(f => ({
  title: `${f.data.homeTeam} vs ${f.data.awayTeam}`,
  slug: f.data.slug,
  start: f.data.start,
  end: f.data.end,
  venue: f.data.venue,
  category: 'sport',
  price: 'See club for ticket prices',
  description: `${f.data.competition} fixture${f.data.matchWeek ? ` (match week ${f.data.matchWeek})` : ''}, Walton & Hersham ${f.data.homeAway === 'home' ? 'at home' : 'away'}.`,
  isFixture: true,
  isAwayFixture: f.data.homeAway === 'away',
}));

// Filter to items whose end date (or start date if no end) is today or in the future.
// "Today" is midnight at build time, Cloudflare Pages rebuilds nightly so past events
// (and played fixtures) drop off the site the morning after they finish.
const today = new Date();
today.setHours(0, 0, 0, 0);

function itemEndDay(item: UpcomingItem): Date {
  const d = new Date(item.end ?? item.start);
  d.setHours(0, 0, 0, 0);
  return d;
}

const upcoming = [...eventItems, ...fixtureItems]
  .filter(item => itemEndDay(item) >= today)
  .sort((a, b) => new Date(a.start).getTime() - new Date(b.start).getTime());

// Exhibitions and runs already under way go in their own "On now" block, so a
// three-week show doesn't sit at the top of every visit. Month headings are
// absolute on purpose: the edge cache can serve this HTML for days, so
// anything relative ("today", "this weekend") is worked out in the browser.
const todayKey = `${today.getFullYear()}-${String(today.getMonth() + 1).padStart(2, '0')}-${String(today.getDate()).padStart(2, '0')}`;
const isOngoing = (item: UpcomingItem) => isMultiDay(item.start, item.end) && item.start.slice(0, 10) <= todayKey;

const onNow = upcoming.filter(isOngoing);

const MONTHS = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
const monthGroups: { key: string; label: string; items: UpcomingItem[] }[] = [];
for (const item of upcoming.filter(i => !isOngoing(i))) {
  const key = item.start.slice(0, 7);
  let group = monthGroups.find(g => g.key === key);
  if (!group) {
    const [y, m] = key.split('-').map(Number);
    group = { key, label: `${MONTHS[m - 1]} ${y}`, items: [] };
    monthGroups.push(group);
  }
  group.items.push(item);
}

const CATEGORY_ORDER = ['family', 'arts', 'music', 'community', 'market', 'food-drink', 'festival', 'sport', 'other'];
const categories = CATEGORY_ORDER.filter(c => upcoming.some(i => i.category === c));
const categoryLabel = (c: string) => c === 'food-drink' ? 'Food & Drink' : c.replace(/\b\w/g, ch => ch.toUpperCase());

function eventSchema(item: UpcomingItem) {
  const isFreeEvent = /^free/i.test(item.price);
  return {
    "@type": "Event",
    "name": item.title,
    "url": `https://walton-on-thames.org/whats-on/${item.slug}/`,
    "startDate": item.start,
    ...(item.end ? { "endDate": item.end } : {}),
    "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
    "eventStatus": "https://schema.org/EventScheduled",
    "location": {
      "@type": "Place",
      "name": item.venue,
      "address": item.isAwayFixture
        ? item.venue
        : { "@type": "PostalAddress", "addressLocality": "Walton-on-Thames", "addressRegion": "Surrey", "addressCountry": "GB" }
    },
    ...(isFreeEvent ? {
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "GBP",
        "availability": "https://schema.org/InStock",
        "url": `https://walton-on-thames.org/whats-on/${item.slug}/`
      }
    } : {}),
    ...(item.image ? { "image": `https://walton-on-thames.org${item.image}` } : {}),
  };
}
---

<BaseLayout
  title="What's On in Walton-on-Thames | Events & Festivals"
  description="Events and things to do in Walton-on-Thames, Hersham and Whiteley Village: festivals, markets, community events, sport and more."
>
  <slot name="structured-data">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://walton-on-thames.org/" },
        { "@type": "ListItem", "position": 2, "name": "What's On", "item": "https://walton-on-thames.org/whats-on/" }
      ]
    })} />
    {upcoming.length > 0 && (
      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "ItemList",
        "itemListElement": upcoming.map((event, i) => ({
          "@type": "ListItem",
          "position": i + 1,
          "item": eventSchema(event)
        }))
      })} />
    )}
  </slot>

  <div class="page-hero">
    <div class="container">
      <nav aria-label="Breadcrumb">
        <ol class="breadcrumbs">
          <li><a href="/">Home</a></li>
          <li aria-current="page">What's On</li>
        </ol>
      </nav>
      <h1>What's On in Walton-on-Thames</h1>
      <p>Events, festivals, markets and community activities across Walton-on-Thames, Hersham and Whiteley Village.</p>
    </div>
  </div>

  <section class="section">
    <div class="container">
      {upcoming.length > 0 ? (
        <>
          <div class="event-filters" data-filters hidden>
            <div class="filter-group" role="group" aria-label="When">
              <span class="filter-label">When</span>
              <button type="button" class="chip" data-when="all" aria-pressed="true">Any date</button>
              <button type="button" class="chip" data-when="today" aria-pressed="false">Today</button>
              <button type="button" class="chip" data-when="weekend" aria-pressed="false">This weekend</button>
              <button type="button" class="chip" data-when="week" aria-pressed="false">Next 7 days</button>
            </div>
            <div class="filter-group" role="group" aria-label="Type">
              <span class="filter-label">Type</span>
              <button type="button" class="chip" data-type="all" aria-pressed="true">Everything</button>
              <button type="button" class="chip" data-type="free" aria-pressed="false">Free</button>
              {categories.map(c => (
                <button type="button" class="chip" data-type={c} aria-pressed="false">{categoryLabel(c)}</button>
              ))}
            </div>
            <p class="filter-count" data-count aria-live="polite"></p>
          </div>

          {onNow.length > 0 && (
            <div class="event-group" data-group>
              <h2 class="group-heading">On now</h2>
              <div class="event-list">
                {onNow.map(item => <EventRow {...item} ongoing />)}
              </div>
            </div>
          )}

          {monthGroups.map(group => (
            <div class="event-group" data-group>
              <h2 class="group-heading">{group.label}</h2>
              <div class="event-list">
                {group.items.map(item => <EventRow {...item} compact={item.isFixture} />)}
              </div>
            </div>
          ))}

          <p class="empty-state" data-no-results hidden>
            Nothing matches those filters. <button type="button" class="link-button" data-reset>Show all events</button>
          </p>
        </>
      ) : (
        <p class="empty-state">No upcoming events right now: check back soon or <a href="/community/news/">read the local news</a>.</p>
      )}

      <div class="submit-event" id="submit-event">
        <div class="submit-event-copy">
          <h2>List your local event for free</h2>
          <p>Businesses, community groups and event organisers can submit relevant events to Walton-on-Thames.org at absolutely no cost. Every event is reviewed before publication.</p>
        </div>
        <a href="/contact/?subject=event-submission" class="btn btn-primary">Submit an event</a>
      </div>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  (function () {
    var filters = document.querySelector('[data-filters]');
    if (!filters) return;
    var rows = Array.prototype.slice.call(document.querySelectorAll('[data-event-row]'));
    var groups = Array.prototype.slice.call(document.querySelectorAll('[data-group]'));
    var count = filters.querySelector('[data-count]');
    var noResults = document.querySelector('[data-no-results]');
    var state = { when: 'all', type: 'all' };

    function key(d) {
      return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
    }
    function addDays(d, n) {
      var c = new Date(d.getFullYear(), d.getMonth(), d.getDate());
      c.setDate(c.getDate() + n);
      return c;
    }

    var now = new Date();
    var today = key(now);
    var tomorrow = key(addDays(now, 1));
    var weekEnd = key(addDays(now, 6));
    // Saturday and Sunday of this week; on a Sunday, just today.
    var dow = now.getDay();
    var satOffset = dow === 0 ? -1 : 6 - dow;
    var weekendFrom = dow === 0 ? today : key(addDays(now, satOffset));
    var weekendTo = key(addDays(now, satOffset + 1));

    function overlaps(row, from, to) {
      return row.dataset.start <= to && row.dataset.end >= from;
    }

    rows.forEach(function (row) {
      // The cached page can outlive an event: drop anything already over.
      if (row.dataset.end < today) row.dataset.past = 'true';
      var soon = row.querySelector('[data-soon]');
      if (row.dataset.start === today) { soon.textContent = 'Today'; soon.hidden = false; }
      else if (row.dataset.start === tomorrow) { soon.textContent = 'Tomorrow'; soon.hidden = false; }
    });

    function matches(row) {
      if (row.dataset.past) return false;
      if (state.when === 'today' && !overlaps(row, today, today)) return false;
      if (state.when === 'weekend' && !overlaps(row, weekendFrom, weekendTo)) return false;
      if (state.when === 'week' && !overlaps(row, today, weekEnd)) return false;
      if (state.type === 'free' && !row.dataset.free) return false;
      if (state.type !== 'all' && state.type !== 'free' && row.dataset.category !== state.type) return false;
      return true;
    }

    function apply() {
      var shown = 0;
      rows.forEach(function (row) {
        var ok = matches(row);
        row.hidden = !ok;
        if (ok) shown++;
      });
      groups.forEach(function (g) {
        g.hidden = !g.querySelector('[data-event-row]:not([hidden])');
      });
      filters.querySelectorAll('[data-when]').forEach(function (b) {
        b.setAttribute('aria-pressed', String(b.dataset.when === state.when));
      });
      filters.querySelectorAll('[data-type]').forEach(function (b) {
        b.setAttribute('aria-pressed', String(b.dataset.type === state.type));
      });
      count.textContent = shown === 1 ? '1 event' : shown + ' events';
      noResults.hidden = shown > 0;
    }

    filters.addEventListener('click', function (e) {
      var b = e.target.closest('button');
      if (!b) return;
      if (b.dataset.when) state.when = b.dataset.when;
      if (b.dataset.type) state.type = b.dataset.type;
      apply();
    });
    document.querySelector('[data-reset]').addEventListener('click', function () {
      state.when = 'all';
      state.type = 'all';
      apply();
    });

    filters.hidden = false;
    apply();
  })();
</script>

<style>
  .event-filters {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: 2rem;
    padding: 1.25rem;
    background: var(--color-white);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
  }

  .event-filters[hidden] { display: none; }

  .filter-group {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }

  .filter-label {
    width: 3.25rem;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-slate);
  }

  .chip {
    min-height: 44px;
    padding: 0 1rem;
    border: 1px solid rgba(11, 36, 46, 0.18);
    border-radius: 999px;
    background: var(--color-white);
    color: var(--color-navy);
    font: 500 0.875rem var(--font-body);
    cursor: pointer;
  }

  .chip:hover { border-color: var(--color-navy); }

  .chip[aria-pressed="true"] {
    background: var(--color-navy);
    border-color: var(--color-navy);
    color: var(--color-white);
  }

  .chip:focus-visible {
    outline: 3px solid var(--color-accent);
    outline-offset: 2px;
  }

  .filter-count {
    font-size: 0.85rem;
    color: var(--color-slate);
  }

  .event-group + .event-group { margin-top: 2.5rem; }
  .event-group[hidden] { display: none; }

  .group-heading {
    position: sticky;
    top: var(--nav-height);
    z-index: 5;
    margin-bottom: 1rem;
    padding: 0.6rem 0;
    background: var(--color-cream);
    font-size: clamp(1.4rem, 2.5vw, 1.85rem);
    border-bottom: 1px solid rgba(11, 36, 46, 0.1);
  }

  .event-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .event-list :global([data-event-row][hidden]) { display: none; }

  .link-button {
    border: 0;
    background: none;
    padding: 0;
    color: var(--color-accent-dark);
    font: inherit;
    text-decoration: underline;
    cursor: pointer;
  }

  /* On a phone each filter row scrolls sideways rather than wrapping, so the
     panel stays two rows tall instead of filling the first screen. */
  @media (max-width: 640px) {
    .event-filters { padding: 0.9rem 0; gap: 0.6rem; }
    .filter-group {
      flex-wrap: nowrap;
      overflow-x: auto;
      scrollbar-width: none;
      padding: 0 0.9rem;
    }
    .filter-group::-webkit-scrollbar { display: none; }
    .filter-label { display: none; }
    .chip { flex: none; padding: 0 0.85rem; }
    .filter-count { padding: 0 0.9rem; }
  }
</style>

<style>
  .empty-state {
    color: var(--color-slate);
    font-size: 1.05rem;
    padding: 2rem 0;
  }

  .submit-event {
    margin-top: 3rem;
    padding: 2rem;
    background: var(--color-white);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .submit-event-copy { flex: 1 1 340px; }

  .submit-event h2 {
    font-size: 1.25rem;
    margin-bottom: 0.4rem;
  }

  .submit-event p { color: var(--color-slate); }
</style>
